{
  "nodes": {
    "clock1": { "type": "Clock", "params": { "bpm": 140.0 } },
    "np1": { "type": "NotePattern", "params": {
      "steps": 4,
      "root_0": 0, "type_0": 1,
      "root_1": 0, "type_1": 1,
      "root_2": 5, "type_2": 1,
      "root_3": 7, "type_3": 0,
      "octave": 3, "beats_per_step": 2, "gate_length": 0.7,
      "velocity": 0.9
    }},
    "ps1": { "type": "WavetableSynth", "params": {
      "wavetable": 1, "position": 0.5,
      "attack": 0.005, "decay": 0.2,
      "sustain": 0.5, "release": 0.2, "amplitude": 0.35
    }},
    "crush1": { "type": "Bitcrush", "params": {
      "bits": 5.0, "rate": 6000.0, "mix": 1.0
    }},
    "gain1": { "type": "Gain", "params": { "gain": 0.7 } },
    "out1": { "type": "audio_out", "params": {} }
  },
  "connections": [
    { "from": "clock1/beat_phase", "to": "np1/beat_phase" },
    { "from": "np1/notes",      "to": "ps1/notes" },
    { "from": "np1/velocities", "to": "ps1/velocities" },
    { "from": "np1/gates",      "to": "ps1/gates" },
    { "from": "ps1/output_left", "to": "crush1/input" },
    { "from": "crush1/output",   "to": "gain1/input" },
    { "from": "gain1/output",    "to": "out1/input" }
  ]
}
