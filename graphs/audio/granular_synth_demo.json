{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "granular_synth_demo",
    "title": "Granular Texture Scanner",
    "description": "A saw oscillator and noise mixed into the granular engine. One LFO scans the grain position through the buffer while a second drifts the pitch, creating evolving textural clouds.",
    "tags": [
      "audio",
      "granular",
      "synthesis",
      "texture",
      "demo"
    ],
    "difficulty": "beginner",
    "domains": [
      "audio",
      "control"
    ],
    "requires_packages": [],
    "featured_rank": 30
  },
  "nodes": {
    "osc": {
      "type": "Oscillator",
      "params": {
        "frequency": 110.0,
        "amplitude": 0.6,
        "waveform": 1
      }
    },
    "noise": {
      "type": "Noise",
      "params": {
        "color": 0,
        "amplitude": 0.25
      }
    },
    "mixer": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 1.0
      }
    },
    "lfo_pos": {
      "type": "lfo_au",
      "params": {
        "frequency": 0.08,
        "amplitude": 0.5,
        "offset": 0.5,
        "waveform": 3
      }
    },
    "lfo_pitch": {
      "type": "lfo_au",
      "params": {
        "frequency": 0.05,
        "amplitude": 4.0,
        "waveform": 0
      }
    },
    "granular": {
      "type": "GranularSynth",
      "params": {
        "grain_size": 60.0,
        "density": 15.0,
        "position": 0.5,
        "pitch": 0.0,
        "randomize": 0.3,
        "window": 0,
        "mix": 1.0
      }
    },
    "gain": {
      "type": "Gain",
      "params": {
        "gain": 0.7
      }
    },
    "out": {
      "type": "audio_out",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "osc/output",
      "to": "mixer/input_1"
    },
    {
      "from": "noise/output",
      "to": "mixer/input_2",
      "bridge": "hold"
    },
    {
      "from": "mixer/output",
      "to": "granular/input"
    },
    {
      "from": "lfo_pos/value",
      "to": "granular/position_cv"
    },
    {
      "from": "lfo_pitch/value",
      "to": "granular/pitch_cv"
    },
    {
      "from": "granular/output",
      "to": "gain/input"
    },
    {
      "from": "gain/output",
      "to": "out/input"
    }
  ],
  "sticky_notes": [
    {
      "id": "note_1",
      "text": "**Granular Synthesis** Chops audio into tiny grains and reassembles them into texture clouds",
      "x": -100.0,
      "y": -80.0,
      "width": 270.0,
      "height": 80.0,
      "color": 0
    },
    {
      "id": "note_2",
      "text": "**Position LFO** scans through the grain buffer \u2014 triangle wave for smooth back-and-forth scanning",
      "x": -100.0,
      "y": 180.0,
      "width": 260.0,
      "height": 80.0,
      "color": 2
    },
    {
      "id": "note_3",
      "text": "**Pitch LFO** drifts the grain pitch \u00b14 semitones for shimmer",
      "x": 250.0,
      "y": 180.0,
      "width": 230.0,
      "height": 60.0,
      "color": 2
    }
  ]
}
