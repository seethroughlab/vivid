{
    "schema_version": 1,
    "meta": {
        "id": "sp404_features_demo",
        "title": "SP404 Feature Demo",
        "description": "Showcases reverse playback, loop crossfade, and static detune — three SP404 nodes each demonstrating one new feature alongside a reference groove.",
        "tags": [
            "sampler",
            "sp404",
            "drums",
            "reverse",
            "loop"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio"
        ],
        "requires_packages": [],
        "featured_rank": 20,
        "estimated_minutes": 3,
        "content_kind": "example",
        "category": "audio",
        "family": "Audio patches",
        "role": "creative",
        "playability": "self_playing"
    },
    "nodes": {
        "clock1": {
            "type": "Clock",
            "params": {
                "bpm": 95.0
            },
            "layout": { "x": 0.0, "y": 150.0 }
        },

        "ds_groove": {
            "type": "DrumSequencer",
            "params": {
                "steps": 16,
                "kick_note": 36,
                "snare_note": 38,
                "hat_note": 40,
                "oh_note": 41,
                "kick_0": 1,
                "kick_10": 1,
                "snare_4": 1,
                "snare_12": 1,
                "hat_0": 1,
                "hat_2": 1,
                "hat_4": 1,
                "hat_6": 1,
                "hat_8": 1,
                "hat_10": 1,
                "hat_12": 1,
                "hat_14": 1,
                "oh_6": 1
            },
            "layout": { "x": 220.0, "y": -150.0 }
        },
        "sp_drums": {
            "type": "SP404",
            "params": {
                "file": "../../assets/audio/sp404-kit/sp404-kit.json",
                "mode": 0,
                "volume": 0.8
            },
            "layout": { "x": 480.0, "y": -150.0 }
        },

        "ds_reverse": {
            "type": "DrumSequencer",
            "params": {
                "steps": 16,
                "hat_note": 41,
                "hat_0": 1,
                "hat_8": 1
            },
            "layout": { "x": 220.0, "y": 50.0 }
        },
        "sp_reverse": {
            "type": "SP404",
            "params": {
                "file": "../../assets/audio/sp404-kit/sp404-kit.json",
                "mode": 0,
                "reverse": 1,
                "volume": 0.7
            },
            "layout": { "x": 480.0, "y": 50.0 }
        },

        "ds_pads": {
            "type": "DrumSequencer",
            "params": {
                "steps": 16,
                "kick_note": 49,
                "kick_0": 1
            },
            "layout": { "x": 220.0, "y": 250.0 }
        },
        "sp_pads": {
            "type": "SP404",
            "params": {
                "file": "../../assets/audio/sp404-kit/sp404-kit.json",
                "mode": 1,
                "attack": 0.02,
                "release": 0.4,
                "loop_crossfade_ms": 30.0,
                "volume": 0.4
            },
            "layout": { "x": 480.0, "y": 250.0 }
        },

        "ds_bells": {
            "type": "DrumSequencer",
            "params": {
                "steps": 16,
                "clap_note": 43,
                "tom_note": 44,
                "clap_2": 1,
                "clap_6": 1,
                "clap_14": 1,
                "tom_10": 1
            },
            "layout": { "x": 220.0, "y": 450.0 }
        },
        "sp_bells": {
            "type": "SP404",
            "params": {
                "file": "../../assets/audio/sp404-kit/sp404-kit.json",
                "mode": 0,
                "detune_semitones": 7.0,
                "volume": 0.55
            },
            "layout": { "x": 480.0, "y": 450.0 }
        },

        "out1": {
            "type": "audio_out",
            "params": {},
            "layout": { "x": 720.0, "y": 150.0 }
        }
    },
    "connections": [
        { "from": "clock1/bar_phase", "to": "ds_groove/beat_phase" },
        { "from": "clock1/bar_phase", "to": "ds_reverse/beat_phase" },
        { "from": "clock1/bar_phase", "to": "ds_pads/beat_phase" },
        { "from": "clock1/bar_phase", "to": "ds_bells/beat_phase" },

        { "from": "ds_groove/notes_out",  "to": "sp_drums/notes_in" },
        { "from": "ds_reverse/notes_out", "to": "sp_reverse/notes_in" },
        { "from": "ds_pads/notes_out",    "to": "sp_pads/notes_in" },
        { "from": "ds_bells/notes_out",   "to": "sp_bells/notes_in" },

        { "from": "sp_drums/output",   "to": "out1/input" },
        { "from": "sp_reverse/output", "to": "out1/input" },
        { "from": "sp_pads/output",    "to": "out1/input" },
        { "from": "sp_bells/output",   "to": "out1/input" }
    ],
    "sticky_notes": [
        {
            "text": "reverse=on\nOpen hat plays from end to start →\nclassic reverse cymbal swell",
            "x": 660.0,
            "y": 10.0
        },
        {
            "text": "loop_crossfade_ms=30\nEqual-power crossfade at the loop\nboundary — smooths clicks on tonal loops",
            "x": 660.0,
            "y": 210.0
        },
        {
            "text": "detune_semitones=+7\nTape-style static pitch offset.\nBells play a perfect 5th above root.",
            "x": 660.0,
            "y": 410.0
        }
    ]
}
