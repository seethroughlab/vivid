  "meta": {
    "id": "tracker_expression_demo",
    "title": "Tracker Expression \u2014 pitch_bend, pressure, timbre",
    "description": "Phase 4 demo. A short Tracker pattern with three expression lanes enabled (pitch_bend, pressure, timbre) drives a WavetableLayer voice. The pattern walks C4 \u2192 E4 \u2192 G4 \u2192 C5 with \u00b16-semi pitch wobble, a pressure swell that peaks on row 4, and a timbre sweep into the final ringing voice. Demonstrates the full Phase 4 surface end-to-end: native PITCH_BEND/PRESSURE/TIMBRE events on the wire, slot.pressure modulating amplitude, slot.timbre modulating wavetable position.",
    "tags": [
      "audio",
      "tracker",
      "expression",
      "phase4",
      "wavetable",
      "demo"
    ],
    "difficulty": "beginner",
    "domains": [
      "audio",
      "control"
    ],
    "requires_packages": [
      "vivid-wavetable"
    ],
    "featured_rank": 99,
    "estimated_minutes": 1,
