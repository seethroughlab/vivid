{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "flanger_demo",
    "title": "Flanger Jet Sweep",
    "description": "A square wave through a flanger with high feedback for a classic jet-sweep effect. LFO modulates the rate for evolving movement.",
    "tags": ["audio", "flanger", "modulation", "demo"],
    "difficulty": "beginner",
    "domains": ["audio", "control"],
    "requires_packages": [],
    "featured_rank": 30
  },
  "nodes": {
    "osc": {
      "type": "Oscillator",
      "params": {
        "frequency": 130.0,
        "amplitude": 0.7,
        "waveform": 2
      }
    },
    "lfo": {
      "type": "LfoAu",
      "params": {
        "frequency": 0.12,
        "amplitude": 0.25,
        "waveform": 0
      }
    },
    "flanger": {
      "type": "Flanger",
      "params": {
        "rate": 0.3,
        "depth": 0.8,
        "feedback": 0.7,
        "mix": 0.6
      }
    },
    "gain": {
      "type": "Gain",
      "params": {
        "gain": 0.7
      }
    },
    "out": {
      "type": "audio_out",
      "params": {}
    }
  },
  "connections": [
    { "from": "osc/output",     "to": "flanger/input"   },
    { "from": "lfo/value",      "to": "flanger/rate_cv"  },
    { "from": "flanger/output", "to": "gain/input"      },
    { "from": "gain/output",    "to": "out/input"       }
  ]
}
