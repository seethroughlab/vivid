{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "noise_mixer_layers",
        "title": "Noise Mixer Layers",
        "description": "Three noise colors (white, pink, brown) each filtered at different cutoffs and mixed together. The Noise thumbnails show characteristic spectrum patterns, the Mixer thumbnail shows converging inputs, and the Filters show different frequency response curves.",
        "tags": [
            "noise",
            "mixer",
            "filter",
            "layering",
            "demo"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio"
        ],
        "requires_packages": [],
        "featured_rank": 29
    },
    "nodes": {
        "noise_white": {
            "type": "Noise",
            "params": {
                "color": 0,
                "amplitude": 0.5
            }
        },
        "noise_pink": {
            "type": "Noise",
            "params": {
                "color": 1,
                "amplitude": 0.6
            }
        },
        "noise_brown": {
            "type": "Noise",
            "params": {
                "color": 2,
                "amplitude": 0.7
            }
        },
        "filter_hi": {
            "type": "Filter",
            "params": {
                "cutoff": 6000.0,
                "resonance": 1.2,
                "mode": 1
            }
        },
        "filter_mid": {
            "type": "Filter",
            "params": {
                "cutoff": 1200.0,
                "resonance": 1.8,
                "mode": 2
            }
        },
        "filter_lo": {
            "type": "Filter",
            "params": {
                "cutoff": 300.0,
                "resonance": 0.8,
                "mode": 0
            }
        },
        "mixer": {
            "type": "Mixer",
            "params": {
                "gain_1": 0.7,
                "gain_2": 0.8,
                "gain_3": 0.9
            }
        },
        "gain": {
            "type": "Gain",
            "params": {
                "gain": 0.5
            }
        },
        "out": {
            "type": "audio_out",
            "params": {}
        }
    },
    "connections": [
        {
            "from": "noise_white/output",
            "to": "filter_hi/input"
        },
        {
            "from": "noise_pink/output",
            "to": "filter_mid/input"
        },
        {
            "from": "noise_brown/output",
            "to": "filter_lo/input"
        },
        {
            "from": "filter_hi/output",
            "to": "mixer/input_1"
        },
        {
            "from": "filter_mid/output",
            "to": "mixer/input_2"
        },
        {
            "from": "filter_lo/output",
            "to": "mixer/input_3"
        },
        {
            "from": "mixer/output",
            "to": "gain/input"
        },
        {
            "from": "gain/output",
            "to": "out/input"
        }
    ]
}
