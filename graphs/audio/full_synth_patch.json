{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "full_synth_patch",
    "title": "Full Synth Patch",
    "description": "A complete modular synth patch showcasing every newly-thumbnailed core operator: Clock drives timing, Envelope shapes amplitude, LFO through Smooth modulates filter cutoff, Noise adds texture through the Mixer, and Filter shapes the final tone.",
    "tags": [
      "synthesis",
      "modular",
      "thumbnail-showcase",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "audio",
      "control"
    ],
    "requires_packages": [],
    "featured_rank": 20
  },
  "nodes": {
    "clock": {
      "type": "clock_au",
      "params": {
        "bpm": 128.0,
        "beats_per_bar": 4
      }
    },
    "env": {
      "type": "envelope_au",
      "params": {
        "attack": 0.01,
        "decay": 0.2,
        "sustain": 0.6,
        "release": 0.35,
        "amplitude": 1.0
      }
    },
    "lfo": {
      "type": "lfo_au",
      "params": {
        "frequency": 0.3,
        "amplitude": 12.0,
        "waveform": 2
      }
    },
    "smooth": {
      "type": "smooth_au",
      "params": {
        "rise_time": 0.05,
        "fall_time": 0.05
      }
    },
    "osc": {
      "type": "Oscillator",
      "params": {
        "frequency": 165.0,
        "amplitude": 0.5,
        "waveform": 1
      }
    },
    "noise": {
      "type": "Noise",
      "params": {
        "color": 1,
        "amplitude": 0.15
      }
    },
    "mixer": {
      "type": "Mixer",
      "params": {
        "gain_1": 1.0,
        "gain_2": 0.4
      }
    },
    "filter": {
      "type": "Filter",
      "params": {
        "cutoff": 800.0,
        "resonance": 2.0,
        "mode": 0
      }
    },
    "gain": {
      "type": "Gain",
      "params": {
        "gain": 0.7
      }
    },
    "out": {
      "type": "audio_out",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "clock/beat_phase",
      "to": "env/beat_phase"
    },
    {
      "from": "lfo/value",
      "to": "smooth/input"
    },
    {
      "from": "smooth/value",
      "to": "filter/cutoff_cv"
    },
    {
      "from": "osc/output",
      "to": "mixer/input_1"
    },
    {
      "from": "noise/output",
      "to": "mixer/input_2"
    },
    {
      "from": "mixer/output",
      "to": "filter/input"
    },
    {
      "from": "filter/output",
      "to": "gain/input"
    },
    {
      "from": "env/value",
      "to": "gain/amplitude_cv"
    },
    {
      "from": "gain/output",
      "to": "out/input"
    }
  ],
  "sticky_notes": [
    {
      "id": "note_1",
      "text": "**Full Modular Synth** Clock \u2192 Envelope \u2192 amplitude shaping LFO \u2192 Smooth \u2192 filter cutoff modulation",
      "x": -100.0,
      "y": -80.0,
      "width": 280.0,
      "height": 80.0,
      "color": 0
    },
    {
      "id": "note_2",
      "text": "**Modulation path** LFO \u2192 Smooth removes zipper noise before reaching the filter cutoff CV",
      "x": -100.0,
      "y": 200.0,
      "width": 260.0,
      "height": 80.0,
      "color": 2
    },
    {
      "id": "note_3",
      "text": "**Audio path** Osc + Noise \u2192 Mixer \u2192 Filter \u2192 Gain Noise adds body to the saw wave",
      "x": 300.0,
      "y": -80.0,
      "width": 250.0,
      "height": 80.0,
      "color": 1
    },
    {
      "id": "note_4",
      "text": "Envelope shapes volume per beat\u2014 the Gain node\u2019s amplitude_cv input",
      "x": 300.0,
      "y": 200.0,
      "width": 250.0,
      "height": 60.0,
      "color": 1
    }
  ]
}
