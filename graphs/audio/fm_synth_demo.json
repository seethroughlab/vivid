{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "fm_synth_demo",
        "title": "FM Synth Bell Tones",
        "description": "An FM synthesizer triggered by a clock, producing bell-like tones with an LFO sweeping the modulation index for evolving timbre. Classic FM synthesis demonstration.",
        "tags": [
            "audio",
            "fm",
            "synthesis",
            "bell",
            "demo"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio",
            "control"
        ],
        "requires_packages": [],
        "featured_rank": 30
    },
    "nodes": {
        "clock": {
            "type": "Clock",
            "params": {
                "bpm": 90.0
            }
        },
        "env_gate": {
            "type": "Envelope",
            "params": {
                "attack": 0.001,
                "decay": 0.01,
                "sustain": 1.0,
                "release": 0.3,
                "amplitude": 1.0
            }
        },
        "lfo_mod": {
            "type": "Lfo",
            "params": {
                "frequency": 0.12,
                "amplitude": 3.0,
                "waveform": 0
            }
        },
        "fm": {
            "type": "FmSynth",
            "params": {
                "carrier_freq": 220.0,
                "mod_ratio": 3.0,
                "mod_index": 4.0,
                "attack": 0.01,
                "decay": 0.3,
                "sustain": 0.4,
                "release": 0.5,
                "amplitude": 0.6
            }
        },
        "gain": {
            "type": "Gain",
            "params": {
                "gain": 0.7
            }
        },
        "out": {
            "type": "audio_out",
            "params": {}
        }
    },
    "connections": [
        {
            "from": "clock/beat_phase",
            "to": "env_gate/beat_phase"
        },
        {
            "from": "env_gate/value",
            "to": "fm/gate_cv"
        },
        {
            "from": "lfo_mod/value",
            "to": "fm/mod_index_cv"
        },
        {
            "from": "fm/output",
            "to": "gain/input"
        },
        {
            "from": "gain/output",
            "to": "out/input"
        }
    ],
    "sticky_notes": [
        {
            "id": "note_1",
            "text": "**FM Synthesis** bell tones Carrier=220 Hz, mod_ratio=3\u00d7 mod_index controls brightness",
            "x": -100.0,
            "y": -80.0,
            "width": 260.0,
            "height": 80.0,
            "color": 0
        },
        {
            "id": "note_2",
            "text": "**Modulation index** is swept by an LFO \u2014 higher index = more overtones = brighter timbre",
            "x": -100.0,
            "y": 150.0,
            "width": 250.0,
            "height": 80.0,
            "color": 2
        },
        {
            "id": "note_3",
            "text": "Envelope creates a gate pulse on each beat to trigger the FM note",
            "x": 250.0,
            "y": -80.0,
            "width": 240.0,
            "height": 60.0,
            "color": 1
        }
    ]
}
