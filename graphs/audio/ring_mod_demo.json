      "type": "Oscillator",
      "params": {
        "frequency": 165.0,
        "amplitude": 0.7,
        "waveform": 1
      }
    },
    "lfo": {
      "type": "LFO",
      "params": {
        "frequency": 0.15,
        "amplitude": 150.0,
