{
    "schema_version": 1,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "stereo_pan_width_demo",
        "title": "Auto-Pan and Stereo Width",
        "description": "A simple tone pans left to right while stereo width breathes independently.",
        "tags": [
            "audio",
            "stereo",
            "panning",
            "spatial",
            "demo"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio",
            "control"
        ],
        "requires_packages": [],
        "featured_rank": 28,
        "estimated_minutes": 3,
        "content_kind": "example",
        "category": "audio",
        "family": "Audio patches",
        "role": "creative",
        "playability": "self_playing"
    },
    "nodes": {
        "osc": {
            "type": "Oscillator",
            "params": {
                "frequency": 330.0,
                "amplitude": 0.6,
                "waveform": 3
            },
            "layout": {
                "x": 0.0,
                "y": 0.0
            }
        },
        "lfo_pan": {
            "type": "Lfo",
            "params": {
                "frequency": 0.25,
                "amplitude": 1.0,
                "waveform": 0
            },
            "layout": {
                "x": 240.0,
                "y": 0.0
            }
        },
        "lfo_width": {
            "type": "Lfo",
            "params": {
                "frequency": 0.08,
                "amplitude": 0.8,
                "offset": 1.0,
                "waveform": 3
            },
            "layout": {
                "x": 480.0,
                "y": 0.0
            }
        },
        "pre_gain": {
            "type": "Gain",
            "params": {
                "gain": 0.8
            },
            "layout": {
                "x": 720.0,
                "y": 0.0
            }
        },
        "pan_width": {
            "type": "StereoPanWidth",
            "params": {
                "pan": 0.0,
                "width": 1.5,
                "ms_balance": 0.5
            },
            "layout": {
                "x": 960.0,
                "y": 0.0
            }
        },
        "out": {
            "type": "audio_out",
            "params": {},
            "layout": {
                "x": 0.0,
                "y": 170.0
            }
        }
    },
    "connections": [
        {
            "from": "osc/output",
            "to": "pre_gain/input"
        },
        {
            "from": "pre_gain/output",
            "to": "pan_width/input"
        },
        {
            "from": "lfo_pan/value",
            "to": "pan_width/pan_cv"
        },
        {
            "from": "lfo_width/value",
            "to": "pan_width/width_cv"
        },
        {
            "from": "pan_width/output",
            "to": "out/input"
        }
    ],
    "sticky_notes": [
        {
            "id": "note_1",
            "text": "**Pan vs Width** **Pan** moves the sound L/R; **Width** controls stereo spread (>1 = wider than source)",
            "x": -100.0,
            "y": -80.0,
            "width": 250.0,
            "height": 100.0,
            "color": 0
        },
        {
            "id": "note_2",
            "text": "Slow pan LFO (0.25 Hz) sweeps the image; width LFO (0.08 Hz) breathes the stereo field",
            "x": -100.0,
            "y": 180.0,
            "width": 250.0,
            "height": 80.0,
            "color": 2
        }
    ]
}
