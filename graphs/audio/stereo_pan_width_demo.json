{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "stereo_pan_width_demo",
    "title": "Auto-Pan and Stereo Width",
    "description": "A triangle oscillator panned by a slow LFO for auto-pan sweep, with a second LFO modulating the stereo width for a breathing spatial effect.",
    "tags": [
      "audio",
      "stereo",
      "panning",
      "spatial",
      "demo"
    ],
    "difficulty": "beginner",
    "domains": [
      "audio",
      "control"
    ],
    "requires_packages": [],
    "featured_rank": 30
  },
  "nodes": {
    "osc": {
      "type": "Oscillator",
      "params": {
        "frequency": 330.0,
        "amplitude": 0.6,
        "waveform": 3
      }
    },
    "lfo_pan": {
      "type": "LFO",
      "params": {
        "frequency": 0.25,
        "amplitude": 1.0,
        "waveform": 0
      }
    },
    "lfo_width": {
      "type": "LFO",
      "params": {
        "frequency": 0.08,
        "amplitude": 0.8,
        "offset": 1.0,
        "waveform": 3
      }
    },
    "pre_gain": {
      "type": "Gain",
      "params": {
        "gain": 0.8
      }
    },
    "pan_width": {
      "type": "StereoPanWidth",
      "params": {
        "pan": 0.0,
        "width": 1.5,
        "ms_balance": 0.5
      }
    },
    "out": {
      "type": "audio_out",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "osc/output",
      "to": "pre_gain/input"
    },
    {
      "from": "pre_gain/output",
      "to": "pan_width/input"
    },
    {
      "from": "lfo_pan/value",
      "to": "pan_width/pan_cv"
    },
    {
      "from": "lfo_width/value",
      "to": "pan_width/width_cv"
    },
    {
      "from": "pan_width/output",
      "to": "out/input"
    }
  ],
  "sticky_notes": [
    {
      "id": "note_1",
      "text": "**Pan vs Width** **Pan** moves the sound L/R; **Width** controls stereo spread (>1 = wider than source)",
      "x": -100.0,
      "y": -80.0,
      "width": 250.0,
      "height": 100.0,
      "color": 0
    },
    {
      "id": "note_2",
      "text": "Slow pan LFO (0.25 Hz) sweeps the image; width LFO (0.08 Hz) breathes the stereo field",
      "x": -100.0,
      "y": 180.0,
      "width": 250.0,
      "height": 80.0,
      "color": 2
    }
  ]
}
