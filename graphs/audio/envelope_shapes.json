{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "envelope_shapes",
        "title": "Envelope Shapes",
        "description": "Three envelopes with contrasting ADSR curves \u2014 plucky, pad, and percussive \u2014 each shaping an oscillator. The node thumbnails show each envelope's distinct curve shape.",
        "tags": [
            "envelope",
            "adsr",
            "synthesis",
            "demo"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio",
            "control"
        ],
        "requires_packages": [],
        "featured_rank": 25
    },
    "nodes": {
        "clock": {
            "type": "ClockAu",
            "params": {
                "bpm": 120.0
            }
        },
        "env_pluck": {
            "type": "EnvelopeAu",
            "params": {
                "attack": 0.001,
                "decay": 0.15,
                "sustain": 0.0,
                "release": 0.1,
                "amplitude": 1.0
            }
        },
        "env_pad": {
            "type": "EnvelopeAu",
            "params": {
                "attack": 0.4,
                "decay": 0.3,
                "sustain": 0.8,
                "release": 1.5,
                "amplitude": 1.0
            }
        },
        "env_perc": {
            "type": "EnvelopeAu",
            "params": {
                "attack": 0.001,
                "decay": 0.08,
                "sustain": 0.3,
                "release": 0.05,
                "amplitude": 1.0
            }
        },
        "osc_pluck": {
            "type": "Oscillator",
            "params": {
                "frequency": 440.0,
                "amplitude": 0.4,
                "waveform": 1
            }
        },
        "osc_pad": {
            "type": "Oscillator",
            "params": {
                "frequency": 220.0,
                "amplitude": 0.3,
                "waveform": 0
            }
        },
        "osc_perc": {
            "type": "Oscillator",
            "params": {
                "frequency": 880.0,
                "amplitude": 0.3,
                "waveform": 2
            }
        },
        "gain_pluck": {
            "type": "Gain",
            "params": {
                "gain": 0.8
            }
        },
        "gain_pad": {
            "type": "Gain",
            "params": {
                "gain": 0.8
            }
        },
        "gain_perc": {
            "type": "Gain",
            "params": {
                "gain": 0.6
            }
        },
        "mixer": {
            "type": "Mixer",
            "params": {
                "gain_1": 1.0,
                "gain_2": 1.0,
                "gain_3": 1.0
            }
        },
        "out": {
            "type": "audio_out",
            "params": {}
        }
    },
    "connections": [
        {
            "from": "clock/beat_phase",
            "to": "env_pluck/beat_phase"
        },
        {
            "from": "clock/beat_phase",
            "to": "env_pad/beat_phase"
        },
        {
            "from": "clock/beat_phase",
            "to": "env_perc/beat_phase"
        },
        {
            "from": "osc_pluck/output",
            "to": "gain_pluck/input"
        },
        {
            "from": "osc_pad/output",
            "to": "gain_pad/input"
        },
        {
            "from": "osc_perc/output",
            "to": "gain_perc/input"
        },
        {
            "from": "env_pluck/value",
            "to": "gain_pluck/amplitude_cv"
        },
        {
            "from": "env_pad/value",
            "to": "gain_pad/amplitude_cv"
        },
        {
            "from": "env_perc/value",
            "to": "gain_perc/amplitude_cv"
        },
        {
            "from": "gain_pluck/output",
            "to": "mixer/input_1"
        },
        {
            "from": "gain_pad/output",
            "to": "mixer/input_2"
        },
        {
            "from": "gain_perc/output",
            "to": "mixer/input_3"
        },
        {
            "from": "mixer/output",
            "to": "out/input"
        }
    ],
    "sticky_notes": [
        {
