{
    "schema_version": 1,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "stereo_mixer_smoke",
        "title": "Stereo Mixer Smoke",
        "description": "Two oscillators panned hard left and right through Mixer to verify stereo bus behavior. Used as a fixture for the stereo-aware Mixer (per-input gain + pan).",
        "tags": [
            "mixer",
            "stereo",
            "pan",
            "smoke",
            "test"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio"
        ],
        "requires_packages": [],
        "estimated_minutes": 1,
        "content_kind": "fixture",
        "category": "audio",
        "family": "Audio patches",
        "role": "test",
        "playability": "self_playing"
    },
    "nodes": {
        "osc_l": {
            "type": "Oscillator",
            "params": {
                "waveform": 0.0,
                "frequency": 440.0,
                "amplitude": 0.5
            },
            "layout": {
                "x": 0.0,
                "y": 0.0
            }
        },
        "osc_r": {
            "type": "Oscillator",
            "params": {
                "waveform": 0.0,
                "frequency": 660.0,
                "amplitude": 0.5
            },
            "layout": {
                "x": 0.0,
                "y": 200.0
            }
        },
        "mixer": {
            "type": "Mixer",
            "params": {
                "gain_0": 0.5,
                "pan_0": -0.6,
                "gain_1": 0.5,
                "pan_1": 0.6
            },
            "layout": {
                "x": 300.0,
                "y": 100.0
            }
        },
        "out": {
            "type": "audio_out",
            "layout": {
                "x": 600.0,
                "y": 100.0
            }
        }
    },
    "connections": [
        {
            "from": "osc_l/output",
            "to": "mixer/input_0"
        },
        {
            "from": "osc_r/output",
            "to": "mixer/input_1"
        },
        {
            "from": "mixer/output",
            "to": "out/input"
        }
    ],
    "viewport": {
        "pan_x": 0.0,
        "pan_y": 0.0,
        "zoom": 1.0
    },
    "sticky_notes": []
}
