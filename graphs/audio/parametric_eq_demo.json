{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "parametric_eq_demo",
        "title": "Parametric EQ Sculpted Noise",
        "description": "White noise sculpted by a 3-band parametric EQ with a sweeping low-mid peak, a cut at 1 kHz, and a boost at 5 kHz. An LFO sweeps band 1 frequency for an audible filter-sweep effect.",
        "tags": [
            "audio",
            "eq",
            "filter",
            "parametric",
            "demo"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio",
            "control"
        ],
        "requires_packages": [],
        "featured_rank": 30
    },
    "nodes": {
        "noise": {
            "type": "Noise",
            "params": {
                "color": 0,
                "amplitude": 0.5
            }
        },
        "lfo": {
            "type": "LfoAu",
            "params": {
                "frequency": 0.12,
                "amplitude": 300.0,
                "waveform": 0
            }
        },
        "eq": {
            "type": "ParametricEQ",
            "params": {
                "band_count": 3,
                "freq_1": 200.0,
                "gain_1": 12.0,
                "q_1": 4.0,
                "type_1": 0,
                "freq_2": 1000.0,
                "gain_2": -6.0,
                "q_2": 2.0,
                "type_2": 0,
                "freq_3": 5000.0,
                "gain_3": 8.0,
                "q_3": 3.0,
                "type_3": 0
            }
        },
        "gain": {
            "type": "Gain",
            "params": {
                "gain": 0.6
            }
        },
        "out": {
            "type": "audio_out",
            "params": {}
        }
    },
    "connections": [
        {
            "from": "noise/output",
            "to": "eq/input"
        },
        {
            "from": "lfo/value",
            "to": "eq/freq_1_cv"
        },
        {
            "from": "eq/output",
            "to": "gain/input"
        },
        {
            "from": "gain/output",
            "to": "out/input"
        }
    ],
    "sticky_notes": [
        {
            "id": "note_1",
            "text": "**3-Band Parametric EQ** Sculpts white noise into a tonal, evolving texture",
            "x": -100.0,
            "y": -80.0,
            "width": 240.0,
            "height": 80.0,
            "color": 0
        },
        {
            "id": "note_2",
            "text": "Band 1: +12 dB sweep (LFO-driven) Band 2: \u22126 dB cut at 1 kHz Band 3: +8 dB boost at 5 kHz",
            "x": -100.0,
            "y": 150.0,
            "width": 260.0,
            "height": 80.0,
            "color": 1
        },
        {
            "id": "note_3",
            "text": "The LFO sweeps Band 1\u2019s frequency \u00b1300 Hz for an audible filter sweep",
            "x": 250.0,
            "y": -80.0,
            "width": 230.0,
            "height": 80.0,
            "color": 2
        }
    ]
}
