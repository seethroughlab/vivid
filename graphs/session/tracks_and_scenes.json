    "id": "session_tracks_and_scenes",
    "title": "Tracks and Scenes",
    "description": "Two independent tracks — Drums and Visual — each with three clips. Three scenes coordinate them into named moments: Intro, Verse, Drop. Shows how tracks evolve independently and how scenes lock in a multi-track state.",
    "tags": ["session", "tracks", "scenes", "drums", "visuals", "intermediate", "tutorial"],
    "difficulty": "intermediate",
    "domains": ["audio", "gpu"],
    "requires_packages": [],
