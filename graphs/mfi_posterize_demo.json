{
  "nodes": {
    "vid":       { "type": "MovieFileIn",      "params": { "file": "media/lake.mp4", "play_mode": 0, "speed": 1.0 } },
    "audio":     { "type": "MovieFileAudioIn", "params": { "file": "media/lake.mp4" } },
    "levels":    { "type": "Levels",           "params": { "brightness": 0.1, "contrast": 1.5, "gamma": 0.9 } },
    "posterize": { "type": "Posterize",        "params": { "levels": 6.0 } },
    "vout":      { "type": "video_out" },
    "aout":      { "type": "audio_out" }
  },
  "connections": [
    { "from": "vid/texture",       "to": "levels/input" },
    { "from": "levels/texture",    "to": "posterize/input" },
    { "from": "posterize/texture", "to": "vout/input" },
    { "from": "vid/time",          "to": "audio/video_time" },
    { "from": "audio/left",        "to": "aout/left" },
    { "from": "audio/right",       "to": "aout/right" }
  ]
}
