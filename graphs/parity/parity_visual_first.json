      "type": "TextureAnalysis",
      "params": {
        "skip_frames": 0
      },
      "layout": [800, 350]
    },
    "osc1": {
      "type": "Oscillator",
      "params": {
        "frequency": 220.0,
        "amplitude": 0.5,
        "waveform": 1
      },
      "layout": [500, 500]
    },
    "filter1": {
      "type": "Filter",
      "params": {
        "cutoff": 800.0,
        "resonance": 1.2,
        "mode": 0
      },
      "layout": [700, 500]
    },
    "gain1": {
      "type": "Gain",
      "params": {
        "gain": 0.4
      },
      "layout": [900, 500]
    },
    "audio_out": {
      "type": "audio_out",
      "params": {},
      "layout": [1100, 500]
    }
  },
  "connections": [
    {
      "from": "lfo_rot/value",
      "to": "shape1/rotation"
    },
    {
      "from": "shape1/texture",
      "to": "feedback1/input"
    },
    {
      "from": "feedback1/texture",
      "to": "bloom1/input"
    },
    {
      "from": "bloom1/texture",
      "to": "video_out/input"
    },
    {
      "from": "bloom1/texture",
      "to": "analyze1/texture"
    },
    {
      "from": "analyze1/brightness",
      "to": "osc1/frequency",
      "from_min": 0.0,
      "from_max": 1.0,
      "to_min": 110.0,
      "to_max": 880.0
    },
    {
      "from": "analyze1/edge_density",
      "to": "filter1/cutoff",
      "from_min": 0.0,
      "from_max": 1.0,
      "to_min": 200.0,
      "to_max": 4000.0
    },
    {
      "from": "osc1/output",
      "to": "filter1/input"
    },
    {
      "from": "filter1/output",
