{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "parity_visual_first",
    "title": "Parity: Visual-First",
    "description": "Visual-first parity fixture. Starts with a GPU motion loop (Shape -> Feedback -> Bloom -> video_out), then adds audio response via TextureAnalysis control signals driving Oscillator and Filter modulation. Workflow notes: Tests whether audio behavior can couple meaningfully to visual structure. The visual side should feel natural and complete on its own; adding audio reactivity should be comparably easy.",
    "tags": [
      "parity",
      "visual-first",
      "fixture",
      "validation"
    ],
    "difficulty": "intermediate",
    "domains": [
      "audio",
      "gpu",
      "control"
    ],
    "requires_packages": [],
    "featured_rank": 901
  },
  "nodes": {
    "lfo_rot": {
      "type": "LFO",
      "params": {
        "frequency": 0.3,
        "amplitude": 3.14,
        "offset": 3.14,
        "waveform": 0
      },
      "layout": [100, 100]
    },
    "shape1": {
      "type": "Shape",
      "params": {
        "radius": 0.2,
        "sides": 5,
        "star": 0.4,
        "rotation": 0.0,
        "r": 1.0,
        "g": 0.4,
        "b": 0.1
      },
      "layout": [300, 100]
    },
    "feedback1": {
      "type": "Feedback",
      "params": {
        "decay": 0.92,
        "mix": 0.6,
        "zoom": 1.01,
        "rotate": 2.0
      },
      "layout": [550, 100]
    },
    "bloom1": {
      "type": "Bloom",
      "params": {
        "threshold": 0.6,
        "intensity": 1.0,
        "radius": 1.2
      },
      "layout": [800, 100]
    },
    "video_out": {
      "type": "video_out",
      "params": {},
      "layout": [1050, 100]
    },
