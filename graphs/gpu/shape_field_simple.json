{
    "schema_version": 1,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "shape_field_simple",
        "title": "ShapeField (SDF)",
        "description": "Self-contained SDF shape field with built-in per-instance LFO modulation on scale, rotation, and color. Simpler wiring than the full Instancer2D pipeline when you just want modulated shapes.",
        "tags": ["demo", "shapes", "sdf", "lfo", "2d"],
        "difficulty": "beginner",
        "domains": ["gpu"],
        "requires_packages": [],
        "featured_rank": 54,
        "estimated_minutes": 1,
        "content_kind": "example",
        "category": "instancing",
        "family": "2D drawable pipeline",
        "role": "creative",
        "playability": "self_playing"
    },
    "nodes": {
        "shapes": {
            "type": "ShapeField",
            "params": {
                "count": 12,
                "shape": 4,
                "base_size": 0.06,
                "softness": 0.01,
                "color_r": 0.4,
                "color_g": 0.7,
                "color_b": 1.0,
                "layout": 2,
                "animate": 1,
                "speed": 0.8
            },
            "layout": { "x": 60.0, "y": 200.0 }
        },
        "render": {
            "type": "Render2D",
            "params": {
                "bg_r": 0.02,
                "bg_g": 0.02,
                "bg_b": 0.05,
                "bg_a": 1.0
            },
            "layout": { "x": 340.0, "y": 200.0 }
        },
        "vout": {
            "type": "video_out",
            "layout": { "x": 600.0, "y": 200.0 }
        }
    },
    "connections": [
        { "from": "shapes/drawable", "to": "render/drawable" },
        { "from": "render/texture",  "to": "vout/input" }
    ]
}
