        "tags": ["demo", "intro", "shapes", "2d", "starter"],
        "difficulty": "beginner",
        "domains": ["gpu"],
        "requires_packages": [],
        "featured_rank": 48,
        "estimated_minutes": 1,
        "content_kind": "example",
        "category": "starter",
        "family": "2D drawable pipeline",
        "role": "starter",
        "playability": "self_playing"
    },
    "nodes": {
        "shape": {
            "type": "Shape2D",
            "params": {
                "sides": 6.0,
                "softness": 0.01,
                "scale_x": 0.3,
                "scale_y": 0.3,
                "r": 0.4,
                "g": 0.85,
                "b": 1.0,
                "a": 1.0
            },
            "layout": { "x": 60.0, "y": 200.0 }
        },
        "render": {
            "type": "Render2D",
            "params": {
                "bg_r": 0.02,
                "bg_g": 0.02,
                "bg_b": 0.05,
                "bg_a": 1.0
            },
            "layout": { "x": 330.0, "y": 200.0 }
        },
        "vout": {
            "type": "video_out",
            "layout": { "x": 580.0, "y": 200.0 }
        }
    },
    "connections": [
        { "from": "shape/drawable",  "to": "render/drawable" },
        { "from": "render/texture",  "to": "vout/input" }
    ]
