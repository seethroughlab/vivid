{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "star_spin_demo",
        "title": "Star Spin",
        "description": "Audio-reactive spinning star with feedback trails and bloom.",
        "tags": [
            "demo",
            "feedback",
            "audio-reactive"
        ],
        "difficulty": "intermediate",
        "domains": [
            "audio",
            "gpu",
            "control"
        ],
        "featured_rank": 10
    },
    "nodes": {
        "aout": {
            "type": "audio_out",
            "layout": {
                "x": 857.1022,
                "y": 710.453
            }
        },
        "bloom": {
            "type": "Bloom",
            "params": {
                "threshold": 0.2,
                "radius": 1.5,
                "passes": 4.0,
                "intensity": 1.2
            }
        },
        "feedback": {
            "type": "Feedback",
            "params": {
                "rotate": 3.0,
                "mix": 0.85,
                "zoom": 1.02,
                "decay": 0.92
            }
        },
        "gain": {
            "type": "Gain",
            "params": {
                "gain": 0.8
            }
        },
        "lfo_rot": {
            "type": "LfoFr",
            "params": {
                "offset": 0.0,
                "frequency": 0.15,
                "amplitude": 3.14
            }
        },
        "lfo_size": {
            "type": "LfoFr",
            "params": {
                "waveform": 0.0,
                "offset": 0.2,
                "frequency": 0.08,
                "amplitude": 0.12
            }
        },
        "osc": {
            "type": "Oscillator",
            "params": {
                "waveform": 1.0,
                "frequency": 110.0,
                "amplitude": 0.6
            }
        },
        "star": {
            "type": "Shape",
            "params": {
                "star": 0.5,
                "softness": 0.005,
                "sides": 5.0,
                "b": 0.2,
                "radius": 0.2,
                "r": 1.0,
                "g": 0.7
            }
        },
        "vout": {
            "type": "video_out"
        }
    },
    "connections": [
        {
            "from": "osc/output",
            "to": "gain/input"
        },
        {
            "from": "gain/output",
            "to": "aout/input"
        },
        {
            "from": "lfo_rot/value",
            "to": "star/rotation"
        },
        {
            "from": "lfo_size/value",
            "to": "star/radius"
        },
        {
            "from": "star/texture",
            "to": "feedback/input"
        },
        {
            "from": "feedback/texture",
            "to": "bloom/input"
        },
        {
            "from": "bloom/texture",
            "to": "vout/input"
        },
        {
            "from": "gain/rms",
            "to": "feedback/zoom",
            "bridge": "rms",
            "from_min": 0.0,
            "from_max": 0.5,
            "to_min": 1.0,
            "to_max": 1.06,
            "clamp": true
        }
    ],
    "sticky_notes": [
        {
            "id": "note_1",
            "text": "**Audio-Reactive Visuals** Audio RMS level drives the feedback zoom \u2014 louder audio = faster spiral expansion.",
            "x": -100.0,
            "y": -80.0,
            "width": 260.0,
            "height": 80.0,
            "color": 0
        },
        {
            "id": "note_2",
            "text": "**RMS → zoom** The wire remaps RMS (0–0.5) to zoom (1.0–1.06). Even a small zoom > 1 makes the feedback spiral outward.",
            "x": -102.52548,
            "y": 101.78204,
            "width": 250.0,
            "height": 80.0,
            "color": 2
        },
        {
            "id": "note_3",
            "text": "Bloom softens the feedback trails into a glowing halo",
            "x": 300.0,
            "y": -80.0,
            "width": 220.0,
            "height": 60.0,
            "color": 3
        }
    ]
}
