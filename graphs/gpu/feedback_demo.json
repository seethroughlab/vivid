{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "feedback_demo",
        "title": "Video Feedback",
        "description": "A star feeds back into itself to create spiraling video trails from a small graph.",
        "tags": [
            "feedback",
            "recursive",
            "trails",
            "demo"
        ],
        "difficulty": "intermediate",
        "domains": [
            "gpu"
        ],
        "requires_packages": [],
        "featured_rank": 2,
        "estimated_minutes": 3,
        "content_kind": "example",
        "category": "visual",
        "family": "Visual patches",
        "role": "hero",
        "playability": "self_playing"
    },
    "nodes": {
        "star": {
            "type": "Shape",
            "params": {
                "sides": 5,
                "star": 0.5,
                "radius": 0.15,
                "softness": 0.01,
                "r": 1.0,
                "g": 0.6,
                "b": 0.2
            },
            "resolution": [
                800,
                600
            ],
            "layout": {
                "x": 0.0,
                "y": 0.0
            }
        },
        "lfo_rot": {
            "type": "LfoFr",
            "params": {
                "frequency": 0.15,
                "amplitude": 3.14,
                "offset": 0.0
            },
            "layout": {
                "x": 240.0,
                "y": 0.0
            }
        },
        "lfo_size": {
            "type": "LfoFr",
            "params": {
                "frequency": 0.08,
                "amplitude": 0.1,
                "offset": 0.2,
                "waveform": 0
            },
            "layout": {
                "x": 480.0,
                "y": 0.0
            }
        },
        "feedback": {
            "type": "Feedback",
            "params": {
                "decay": 0.92,
                "mix": 0.8,
                "zoom": 1.02,
                "rotate": 3.0
            },
            "layout": {
                "x": 720.0,
                "y": 0.0
            }
        },
        "vout": {
            "type": "video_out",
            "layout": {
                "x": 960.0,
                "y": 0.0
            }
        }
    },
    "connections": [
        {
            "from": "lfo_rot/value",
            "to": "star/rotation"
        },
        {
            "from": "lfo_size/value",
            "to": "star/radius"
        },
        {
            "from": "star/texture",
            "to": "feedback/input"
        },
        {
            "from": "feedback/texture",
            "to": "vout/input"
        }
    ],
    "sticky_notes": [
        {
            "id": "note_1",
            "text": "**Feedback Loop** Each frame mixes the new star with a decayed, zoomed copy of the previous frame",
            "x": -100.0,
            "y": -80.0,
            "width": 260.0,
            "height": 100.0,
            "color": 0
        },
        {
            "id": "note_2",
            "text": "**decay=0.92**: previous frame fades 8% each frame **zoom=1.02**: old frame grows \u2192 creates spiraling trail effect",
            "x": -100.0,
            "y": 180.0,
            "width": 260.0,
            "height": 100.0,
            "color": 4
        }
    ]
}
