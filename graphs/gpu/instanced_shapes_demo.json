{
  "meta": {
    "title": "Instanced Shapes Demo",
    "description": "Demonstrates per-instance LFO modulation of scale, rotation, and color on instanced shapes.",
    "tags": ["demo", "instanced-shapes", "lfo", "owned-modulation"],
    "difficulty": "beginner",
    "domains": ["gpu"]
  },
  "nodes": {
    "shapes": {
      "type": "Instanced Shapes",
      "params": {
        "count": 16,
        "shape": 4,
        "base_size": 0.06,
        "softness": 0.005,
        "color_r": 0.4,
        "color_g": 0.7,
        "color_b": 1.0,
        "layout": 2,
        "animate": 1,
        "speed": 0.8,
        "scale_enabled": 1,
        "scale_amount": 0.8,
        "rotation_enabled": 1,
        "rotation_amount": 1.0,
        "color_mod_enabled": 0,
        "color_mod_amount": 1.0
      },
      "embedded_ops": {
        "scale": {
          "type": "LFO",
          "params": { "rate": 0.5, "waveform": 0, "offset": 0.0 }
        },
        "rotation": {
          "type": "LFO",
          "params": { "rate": 0.3, "waveform": 0, "offset": 0.0 }
        },
        "color_mod": {
          "type": "LFO",
          "params": { "rate": 0.2, "waveform": 0, "offset": 0.0 }
        }
      }
    },
    "bloom": {
      "type": "Bloom",
      "params": {
        "threshold": 0.3,
        "intensity": 1.2,
        "radius": 3.0
      }
    },
    "vout": {
      "type": "video_out",
      "params": {}
    }
  },
  "connections": [
    { "from": "shapes/texture", "to": "bloom/input" },
    { "from": "bloom/texture", "to": "vout/input" }
  ],
  "sticky_notes": [
    {
      "id": "note_modulation",
      "text": "**Owned LFO Modulation**\n\nEach shape instance has its own LFO for scale and rotation.\nEnable color_mod to add per-instance color variation.",
      "x": -300,
      "y": -100,
      "width": 280,
      "height": 100,
      "color": 0
    }
  ]
}