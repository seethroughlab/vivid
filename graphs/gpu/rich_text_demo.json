{
    "schema_version": 1,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "rich_text_demo",
        "title": "RichText",
        "description": "Animated text floats over noise and bloom for a compact typography patch.",
        "tags": [
            "demo",
            "typography",
            "text",
            "kinetic"
        ],
        "difficulty": "intermediate",
        "domains": [
            "gpu"
        ],
        "requires_packages": [],
        "featured_rank": 36,
        "estimated_minutes": 3,
        "content_kind": "example",
        "category": "visual",
        "family": "Visual patches",
        "role": "creative",
        "playability": "self_playing"
    },
    "nodes": {
        "text": {
            "type": "RichText",
            "params": {
                "text": "VIVID",
                "size": 0.2,
                "anim_mode": 1,
                "anim_speed": 2.0,
                "r": 0.2,
                "g": 0.9,
                "b": 1.0
            },
            "layout": {
                "x": 0.0,
                "y": 0.0
            }
        },
        "noise": {
            "type": "NoiseTexture",
            "params": {
                "scale": 4.0,
                "speed": 0.3,
                "octaves": 2
            },
            "layout": {
                "x": 240.0,
                "y": 0.0
            }
        },
        "comp": {
            "type": "Composite",
            "params": {
                "blend_mode": 3
            },
            "layout": {
                "x": 480.0,
                "y": 0.0
            }
        },
        "bloom": {
            "type": "Bloom",
            "params": {
                "threshold": 0.3,
                "intensity": 0.8,
                "radius": 1.5,
                "passes": 4
            },
            "layout": {
                "x": 720.0,
                "y": 0.0
            }
        },
        "vout": {
            "type": "video_out",
            "layout": {
                "x": 960.0,
                "y": 0.0
            }
        }
    },
    "connections": [
        {
            "from": "text/texture",
            "to": "comp/layer_0"
        },
        {
            "from": "noise/texture",
            "to": "comp/layer_1"
        },
        {
            "from": "comp/texture",
            "to": "bloom/input"
        },
        {
            "from": "bloom/texture",
            "to": "vout/input"
        }
    ]
}
