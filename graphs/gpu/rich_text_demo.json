{
    "schema_version": 1,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "rich_text_demo",
        "title": "Kinetic Text",
        "description": "Wave-animated typography over a noise wash and bloom. Demonstrates Text2D's animation modes (Phase E.7 subsumed RichText into Text2D).",
        "tags": [
            "demo",
            "typography",
            "text",
            "kinetic"
        ],
        "difficulty": "intermediate",
        "domains": [
            "gpu"
        ],
        "requires_packages": [],
        "featured_rank": 36,
        "estimated_minutes": 3,
        "content_kind": "example",
        "category": "visual",
        "family": "Visual patches",
        "role": "creative",
        "playability": "self_playing"
    },
    "nodes": {
        "text": {
            "type": "Text2D",
            "params": {
                "text": "VIVID",
                "font_size": 0.4,
                "position_x": 0.0,
                "position_y": 0.0,
                "anchor": 4,
                "r": 0.2,
                "g": 0.9,
                "b": 1.0,
                "a": 1.0,
                "anim_mode": 1,
                "anim_speed": 2.0,
                "anim_amount": 0.6
            },
            "layout": { "x": 30.0, "y": 80.0 }
        },
        "render": {
            "type": "Render2D",
            "params": {
                "bg_r": 0.0,
                "bg_g": 0.0,
                "bg_b": 0.0,
                "bg_a": 0.0
            },
            "layout": { "x": 290.0, "y": 80.0 }
        },
        "noise": {
            "type": "NoiseTexture",
            "params": {
                "scale": 4.0,
                "speed": 0.3,
                "octaves": 2
            },
            "layout": { "x": 290.0, "y": 260.0 }
        },
        "comp": {
            "type": "Composite",
            "params": { "blend_mode": 3 },
            "layout": { "x": 560.0, "y": 160.0 }
        },
        "bloom": {
            "type": "Bloom",
            "params": {
                "threshold": 0.3,
                "intensity": 0.8,
                "radius": 1.5,
                "passes": 4
            },
            "layout": { "x": 820.0, "y": 160.0 }
        },
        "vout": {
            "type": "video_out",
            "layout": { "x": 1070.0, "y": 160.0 }
        }
    },
    "connections": [
        { "from": "text/drawable",   "to": "render/drawable" },
        { "from": "render/texture",  "to": "comp/layer_0" },
        { "from": "noise/texture",   "to": "comp/layer_1" },
        { "from": "comp/texture",    "to": "bloom/input" },
        { "from": "bloom/texture",   "to": "vout/input" }
    ]
}
