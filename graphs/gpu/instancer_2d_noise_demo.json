{
    "schema_version": 1,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "instancer_2d_noise_demo",
        "title": "Instancer2D + Noise Jitter",
        "description": "Canonical 3-node 2D instancing recipe: a shape, a grid layout, and per-instance noise jitter (position, rotation, scale). Drop-in template for tiled decorative patterns.",
        "tags": ["demo", "instancing", "grid", "noise", "2d"],
        "difficulty": "beginner",
        "domains": ["gpu"],
        "requires_packages": [],
        "featured_rank": 52,
        "estimated_minutes": 2,
        "content_kind": "example",
        "category": "instancing",
        "family": "2D drawable pipeline",
        "role": "creative",
        "playability": "self_playing"
    },
    "nodes": {
        "shape": {
            "type": "Shape2D",
            "params": {
                "sides": 6.0,
                "softness": 0.01,
                "scale_x": 0.06,
                "scale_y": 0.06,
                "r": 0.95,
                "g": 0.75,
                "b": 0.35,
                "a": 1.0
            },
            "layout": { "x": 30.0,  "y": 120.0 }
        },
        "grid": {
            "type": "InstanceGrid2D",
            "params": {
                "count": 64.0,
                "layout": 0.0,
                "spacing": 0.2,
                "scale": 1.0
            },
            "layout": { "x": 30.0,  "y": 300.0 }
        },
        "noise": {
            "type": "InstanceNoise2D",
            "params": {
                "position_jitter": 0.05,
                "rotation_jitter": 0.8,
                "scale_jitter": 0.3,
                "speed": 1.5,
                "seed": 42.0
            },
            "layout": { "x": 280.0, "y": 300.0 }
        },
        "inst": {
            "type": "Instancer2D",
            "layout": { "x": 530.0, "y": 200.0 }
        },
        "render": {
            "type": "Render2D",
            "params": {
                "bg_r": 0.02,
                "bg_g": 0.02,
                "bg_b": 0.05,
                "bg_a": 1.0
            },
            "layout": { "x": 780.0, "y": 200.0 }
        },
        "vout": {
            "type": "video_out",
            "layout": { "x": 1020.0, "y": 200.0 }
        }
    },
    "connections": [
        { "from": "shape/drawable",  "to": "inst/drawable" },
        { "from": "grid/instances",  "to": "noise/instances" },
        { "from": "noise/instances", "to": "inst/instances" },
        { "from": "inst/drawable",   "to": "render/drawable" },
        { "from": "render/texture",  "to": "vout/input" }
    ]
}
