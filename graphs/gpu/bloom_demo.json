{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "bloom_demo",
        "title": "Bloom Glow",
        "description": "A rotating star blooms into a soft glow, showing how bright shapes spill light into the frame.",
        "tags": [
            "bloom",
            "glow",
            "post-processing",
            "demo"
        ],
        "difficulty": "intermediate",
        "domains": [
            "gpu"
        ],
        "requires_packages": [],
        "featured_rank": 30,
        "estimated_minutes": 3,
        "content_kind": "example",
        "category": "visual",
        "family": "Visual patches",
        "role": "creative",
        "playability": "self_playing"
    },
    "nodes": {
        "star": {
            "type": "Shape",
            "params": {
                "sides": 5,
                "star": 0.5,
                "radius": 0.25,
                "softness": 0.01,
                "r": 1.0,
                "g": 0.9,
                "b": 0.5
            },
            "resolution": [
                800,
                600
            ],
            "layout": {
                "x": 0.0,
                "y": 0.0
            }
        },
        "lfo_rot": {
            "type": "LfoFr",
            "params": {
                "frequency": 0.1,
                "amplitude": 3.14,
                "offset": 0.0
            },
            "layout": {
                "x": 240.0,
                "y": 0.0
            }
        },
        "bloom": {
            "type": "Bloom",
            "params": {
                "threshold": 0.3,
                "intensity": 1.5,
                "radius": 1.5,
                "passes": 4
            },
            "layout": {
                "x": 480.0,
                "y": 0.0
            }
        },
        "vout": {
            "type": "video_out",
            "layout": {
                "x": 720.0,
                "y": 0.0
            }
        }
    },
    "connections": [
        {
            "from": "lfo_rot/value",
            "to": "star/rotation"
        },
        {
            "from": "star/texture",
            "to": "bloom/input"
        },
        {
            "from": "bloom/texture",
            "to": "vout/input"
        }
    ]
}
