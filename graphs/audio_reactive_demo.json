{
  "nodes": {
    "lfo1":   { "type": "LFO",        "params": { "frequency": 0.5, "amplitude": 0.4, "offset": 0.5 } },
    "osc1":   { "type": "Oscillator",  "params": { "frequency": 220.0, "amplitude": 0.8 } },
    "gain1":  { "type": "Gain",        "params": { "gain": 1.0 } },
    "noise1": { "type": "Noise",       "params": { "speed": 1.0 } }
  },
  "connections": [
    { "from": "lfo1/value",  "to": "osc1/amplitude" },
    { "from": "osc1/output", "to": "gain1/input" },
    { "from": "gain1/rms",   "to": "noise1/scale" }
  ]
}
