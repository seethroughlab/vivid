{
  "nodes": {
    "clock1": { "type": "Clock", "params": { "bpm": 72.0 } },
    "np1": { "type": "NotePattern", "params": {
      "steps": 4,
      "root_0": 0, "type_0": 1,
      "root_1": 7, "type_1": 0,
      "root_2": 4, "type_2": 1,
      "root_3": 11, "type_3": 0,
      "octave": 4, "beats_per_step": 4, "gate_length": 0.4,
      "velocity": 0.7
    }},
    "ps1": { "type": "Polysynth", "params": {
      "waveform": 0, "attack": 0.01, "decay": 0.15,
      "sustain": 0.3, "release": 0.6, "amplitude": 0.3
    }},
    "reverb1": { "type": "Reverb", "params": {
      "room_size": 0.75, "damping": 0.4, "mix": 0.45
    }},
    "gain1": { "type": "Gain", "params": { "gain": 0.8 } },
    "out1": { "type": "audio_out", "params": {} }
  },
  "connections": [
    { "from": "clock1/beat_phase", "to": "np1/beat_phase" },
    { "from": "np1/notes",      "to": "ps1/notes" },
    { "from": "np1/velocities", "to": "ps1/velocities" },
    { "from": "np1/gates",      "to": "ps1/gates" },
    { "from": "ps1/output_left", "to": "reverb1/input" },
    { "from": "reverb1/output",  "to": "gain1/input" },
    { "from": "gain1/output",    "to": "out1/input" }
  ]
}
