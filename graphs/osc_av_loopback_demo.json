{
  "nodes": {
    "clock1": { "type": "Clock", "params": { "bpm": 120.0 } },
    "lfo1":   { "type": "LFO", "params": { "amplitude": 0.5, "offset": 0.5, "frequency": 0.25 } },
    "oscout": { "type": "OscOut", "params": { "host": "127.0.0.1", "target_port": 9001, "address": "/vivid/value", "value_type": 0, "send_mode": 1 } },
    "oscin":  { "type": "OscIn", "params": { "listen_port": 9001, "strict_address": 1, "address": "/vivid/value" } },
    "osc1":   { "type": "Oscillator", "params": { "frequency": 220.0, "amplitude": 0.5 } },
    "gain1":  { "type": "Gain", "params": { "gain": 0.0 } },
    "noise1": { "type": "Noise", "params": { "scale": 2.0, "speed": 1.0 } },
    "out1":   { "type": "audio_out", "params": {} },
    "vout":   { "type": "video_out", "params": {} }
  },
  "connections": [
    { "from": "clock1/beat_phase", "to": "lfo1/phase" },
    { "from": "lfo1/value", "to": "oscout/value" },
    { "from": "osc1/output", "to": "gain1/input" },
    { "from": "gain1/output", "to": "out1/input" },
    { "from": "oscin/value", "to": "gain1/gain" },
    { "from": "oscin/value", "to": "noise1/speed" },
    { "from": "noise1/texture", "to": "vout/input" }
  ]
}
