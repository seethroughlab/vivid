{
  "nodes": {
    "clock1": { "type": "Clock", "params": { "bpm": 120.0 } },
    "lfo1":   { "type": "LFO",   "params": { "amplitude": 2.0, "offset": 4.0 } },
    "noise1": { "type": "Noise", "params": { "speed": 1.0 } }
  },
  "connections": [
    { "from": "clock1/beat_phase", "to": "lfo1/phase" },
    { "from": "lfo1/value",        "to": "noise1/scale" }
  ]
}
