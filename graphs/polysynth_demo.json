{
  "nodes": {
    "clock1": { "type": "Clock", "params": { "bpm": 120.0 } },
    "np1": { "type": "NotePattern", "params": {
      "steps": 4,
      "root_0": 0, "type_0": 1,
      "root_1": 5, "type_1": 1,
      "root_2": 8, "type_2": 0,
      "root_3": 7, "type_3": 0,
      "octave": 4, "beats_per_step": 4, "gate_length": 0.8,
      "velocity": 0.8
    }},
    "ps1": { "type": "Polysynth", "params": {
      "waveform": 1, "attack": 0.01, "decay": 0.2,
      "sustain": 0.6, "release": 0.3, "amplitude": 0.3
    }},
    "out1": { "type": "audio_out", "params": {} }
  },
  "connections": [
    { "from": "clock1/beat_phase", "to": "np1/beat_phase" },
    { "from": "np1/notes", "to": "ps1/notes" },
    { "from": "np1/velocities", "to": "ps1/velocities" },
    { "from": "np1/gates", "to": "ps1/gates" },
    { "from": "ps1/output_left",  "to": "out1/left" },
    { "from": "ps1/output_right", "to": "out1/right" }
  ]
}
