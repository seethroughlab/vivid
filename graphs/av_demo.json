{
  "nodes": {
    "clock1":  { "type": "Clock",      "params": { "bpm": 120.0 } },
    "lfo_vis": { "type": "LFO",        "params": { "amplitude": 3.0, "offset": 5.0 } },
    "lfo_aud": { "type": "LFO",        "params": { "amplitude": 100.0, "offset": 330.0 } },
    "noise1":  { "type": "Noise",       "params": { "speed": 1.0 } },
    "osc1":    { "type": "Oscillator",  "params": { "frequency": 330.0, "amplitude": 0.5 } },
    "gain1":   { "type": "Gain",        "params": { "gain": 0.3 } }
  },
  "connections": [
    { "from": "clock1/beat_phase", "to": "lfo_vis/phase" },
    { "from": "clock1/beat_phase", "to": "lfo_aud/phase" },
    { "from": "lfo_vis/value",     "to": "noise1/scale" },
    { "from": "lfo_aud/value",     "to": "osc1/frequency" },
    { "from": "osc1/output",       "to": "gain1/input" }
  ]
}
