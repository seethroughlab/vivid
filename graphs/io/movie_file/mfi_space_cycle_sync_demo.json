{
  "schema_version": 1,
  "vivid_version": "0.1.0",
    "nodes": {
        "kb": {
            "type": "Keyboard",
            "params": {
                "key": "space"
            }
        },
        "step": {
            "type": "StepCounter",
            "params": {
                "initial": 0.0
            }
        },
        "files": {
            "type": "FolderList",
            "params": {
                "sort_mode": 0.0,
                "extensions": "mov, mp4",
                "folder": "../../../assets/sync"
            },
            "layout": {
                "x": 30.0,
                "y": 506.5
            }
        },
        "pick": {
            "type": "StringSelect"
        },
        "movie": {
            "type": "MovieLoaded",
            "params": {
                "speed": 1.0,
                "play_mode": 0.0,
                "file": ""
            }
        },
        "movie_audio": {
            "type": "MovieAudioOut",
            "params": {
                "volume": 1.0
            }
        },
        "movie_video": {
            "type": "MovieVideoOut"
        },
        "aout": {
            "type": "audio_out"
        },
        "bname": {
            "type": "Basename"
        },
        "label": {
            "type": "Text",
            "params": {
                "y": -0.8999999761581421,
                "bg_a": 0.5,
                "size": 0.05999999865889549
            }
        },
        "comp": {
            "type": "Composite"
        },
        "vout": {
            "type": "video_out"
        }
    },
    "connections": [
        {
            "from": "kb/pressed",
            "to": "step/trigger"
        },
        {
            "from": "files/count",
            "to": "step/modulus"
        },
        {
            "from": "files/files",
            "to": "pick/files"
        },
        {
            "from": "step/index",
            "to": "pick/index"
        },
        {
            "from": "pick/file",
            "to": "movie/file"
        },
        {
            "from": "movie/media_clock",
            "to": "movie_audio/media_stream"
        },
        {
            "from": "movie/media_clock",
            "to": "movie_video/media_stream"
        },
        {
            "from": "movie_audio/left",
            "to": "aout/left"
        },
        {
            "from": "movie_audio/right",
            "to": "aout/right"
        },
        {
            "from": "pick/file",
            "to": "bname/path"
        },
        {
            "from": "bname/name",
            "to": "label/text"
        },
        {
            "from": "label/texture",
            "to": "comp/a"
        },
        {
            "from": "movie_video/texture",
            "to": "comp/b"
        },
        {
            "from": "comp/texture",
            "to": "vout/input"
        }
    ],
    "viewport": {
        "pan_x": 0.0,
        "pan_y": 0.0,
        "zoom": 1.0
    }
}
