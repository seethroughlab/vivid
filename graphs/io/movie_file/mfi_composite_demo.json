{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "mfi_composite_demo",
    "title": "Movie File: Composite",
    "description": "Blends two video files with LFO-animated opacity and levels adjustment.",
    "tags": [
      "file",
      "mfi",
      "composite",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "io",
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 40
  },
  "nodes": {
    "vid1": {
      "type": "MovieFileIn",
      "params": {
        "file": "../../../assets/camera.mp4",
        "play_mode": 0,
        "speed": 1.0
      }
    },
    "vid2": {
      "type": "MovieFileIn",
      "params": {
        "file": "../../../assets/kitchen.mp4",
        "play_mode": 0,
        "speed": 0.5
      }
    },
    "audio": {
      "type": "MovieFileAudio",
      "params": {
        "file": "../../../assets/camera.mp4"
      }
    },
    "comp": {
      "type": "Composite",
      "params": {
        "blend_mode": 3,
        "opacity": 0.6
      }
    },
    "levels": {
      "type": "Levels",
      "params": {
        "brightness": 0.05,
        "contrast": 1.3
      }
    },
    "lfo1": {
      "type": "LFO",
      "params": {
        "frequency": 0.08,
        "amplitude": 0.4,
        "offset": 0.5
      }
    },
    "vout": {
      "type": "video_out"
    },
    "aout": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "vid1/texture",
      "to": "comp/a"
    },
    {
      "from": "vid2/texture",
      "to": "comp/b"
    },
    {
      "from": "lfo1/value",
      "to": "comp/opacity"
    },
    {
      "from": "comp/texture",
      "to": "levels/input"
    },
    {
      "from": "levels/texture",
      "to": "vout/input"
    },
    {
      "from": "audio/time",
      "to": "vid1/audio_time"
    },
    {
      "from": "audio/output",
      "to": "aout/input"
    }
  ]
}
