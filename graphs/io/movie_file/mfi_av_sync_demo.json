{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "nodes": {
    "vid": {
      "type": "MovieFileIn",
      "params": {
        "file": "../../../assets/camera.mp4"
      },
      "layout": {
        "x": 30.0,
        "y": 409.0
      }
    },
    "audio": {
      "type": "MovieFileAudio",
      "params": {
        "file": "../../../assets/camera.mp4"
      },
      "layout": {
        "x": 230.0,
        "y": 512.0
      }
    },
    "rev": {
      "type": "Reverb",
      "params": {
        "damping": 0.4,
        "room_size": 0.5
      },
      "layout": {
        "x": 430.0,
        "y": 451.0
      }
    },
    "vout": {
      "type": "video_out",
      "layout": {
        "x": 230.0,
        "y": 335.0
      }
    },
    "aout": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "vid/texture",
      "to": "vout/input"
    },
    {
      "from": "audio/time",
      "to": "vid/audio_time"
    },
    {
      "from": "audio/output",
      "to": "rev/input"
    },
    {
      "from": "rev/output",
      "to": "aout/input"
    }
  ],
  "meta": {
    "id": "mfi_av_sync",
    "title": "Movie File: AV Sync",
    "description": "AV sync using cadence-native MovieFileIn + MovieFileAudio operators. Audio time crosses the cadence bridge to sync video.",
    "tags": [
      "movie",
      "audio-visual",
      "reverb",
      "demo"
    ],
    "difficulty": "beginner",
    "domains": [
      "io",
      "audio",
      "gpu"
    ]
  }
}
