{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "mfi_halftone_demo",
    "title": "Mfi Halftone",
    "description": "Mfi Halftone demo graph.",
    "tags": [
      "file",
      "mfi",
      "halftone",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "io",
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 42
  },
  "nodes": {
    "vid": {
      "type": "MovieLoaded",
      "params": {
        "file": "../../../assets/camera.mp4",
        "play_mode": 0,
        "speed": 1.0
      }
    },
    "audio": {
      "type": "MovieAudioOut",
      "params": {
        "file": "../../../assets/camera.mp4"
      }
    },
    "halftone": {
      "type": "Halftone",
      "params": {
        "dot_size": 12.0,
        "angle": 0.4
      }
    },
    "lfo1": {
      "type": "LFO",
      "params": {
        "frequency": 0.15,
        "amplitude": 20.0,
        "offset": 10.0
      }
    },
    "vout": {
      "type": "video_out"
    },
    "aout": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "vid/texture",
      "to": "halftone/input"
    },
    {
      "from": "lfo1/value",
      "to": "halftone/dot_size"
    },
    {
      "from": "halftone/texture",
      "to": "vout/input"
    },
    {"from": "vid/media_clock", "to": "audio/media_stream"},
    {
      "from": "audio/left",
      "to": "aout/left"
    },
    {
      "from": "audio/right",
      "to": "aout/right"
    }
  ]
}
