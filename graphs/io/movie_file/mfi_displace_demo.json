{
  "meta": {
    "id": "mfi_displace_demo",
    "title": "Mfi Displace",
    "description": "Mfi Displace demo graph.",
    "tags": [
      "file",
      "mfi",
      "displace",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "io",
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 41
  },
  "nodes": {
    "vid": {
      "type": "MovieLoaded",
      "params": {
        "file": "../../../assets/sword.mp4",
        "play_mode": 0,
        "speed": 1.0
      }
    },
    "audio": {
      "type": "MovieAudioOut",
      "params": {
        "file": "../../../assets/sword.mp4"
      }
    },
    "noise": {
      "type": "Noise",
      "params": {
        "scale": 3.0,
        "speed": 0.5,
        "octaves": 2
      }
    },
    "displace": {
      "type": "Displace",
      "params": {
        "amount": 0.05
      }
    },
    "lfo1": {
      "type": "LFO",
      "params": {
        "frequency": 0.1,
        "amplitude": 0.08,
        "offset": 0.04
      }
    },
    "vout": {
      "type": "video_out"
    },
    "aout": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "vid/texture",
      "to": "displace/source"
    },
    {
      "from": "noise/texture",
      "to": "displace/map"
    },
    {
      "from": "lfo1/value",
      "to": "displace/amount"
    },
    {
      "from": "displace/texture",
      "to": "vout/input"
    },
    {"from": "vid/media_clock", "to": "audio/media_stream"},
    {
      "from": "audio/left",
      "to": "aout/left"
    },
    {
      "from": "audio/right",
      "to": "aout/right"
    }
  ]
}
