{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "syphon_in_demo",
        "title": "Syphon Input",
        "description": "Receives a video stream from another application via Syphon (macOS inter-app video sharing).",
        "tags": [
            "syphon",
            "in",
            "demo"
        ],
        "difficulty": "advanced",
        "domains": [
            "io",
            "gpu"
        ],
        "requires_packages": [],
        "featured_rank": 45
    },
    "nodes": {
        "sin1": {
            "type": "SyphonIn",
            "params": {
                "active": 1,
                "server_name": ""
            }
        },
        "vout": {
            "type": "video_out",
            "params": {
                "fit_mode": 0
            }
        }
    },
    "connections": [
        {
            "from": "sin1/texture",
            "to": "vout/input"
        }
    ]
}
