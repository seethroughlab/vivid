{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "osc_av_in_demo",
    "title": "Osc Av In",
    "description": "Osc Av In demo graph.",
    "tags": [
      "osc",
      "av",
      "in",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "io",
      "audio",
      "gpu",
      "control"
    ],
    "requires_packages": [],
    "featured_rank": 10
  },
  "nodes": {
    "oscin": {
      "type": "OscIn",
      "params": {
        "listen_port": 9000,
        "strict_address": 1,
        "address": "/vivid/value"
      }
    },
    "osc1": {
      "type": "Oscillator",
      "params": {
        "frequency": 220.0,
        "amplitude": 0.6
      }
    },
    "gain1": {
      "type": "Gain",
      "params": {
        "gain": 0.0
      }
    },
    "noise1": {
      "type": "NoiseTexture",
      "params": {
        "scale": 2.0,
        "speed": 1.0
      }
    },
    "out1": {
      "type": "audio_out",
      "params": {}
    },
    "vout": {
      "type": "video_out",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "osc1/output",
      "to": "gain1/input"
    },
    {
      "from": "gain1/output",
      "to": "out1/input"
    },
    {
      "from": "oscin/value",
      "to": "gain1/gain"
    },
    {
      "from": "oscin/value",
      "to": "noise1/speed"
    },
    {
      "from": "noise1/texture",
      "to": "vout/input"
    }
  ]
}
