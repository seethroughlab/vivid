{
  "nodes": {
    "vid":          { "type": "MovieFileIn",      "params": { "file": "media/sword.mp4", "play_mode": 0, "speed": 1.0 } },
    "audio":        { "type": "MovieFileAudioIn", "params": { "file": "media/sword.mp4" } },
    "edge":         { "type": "Edge",             "params": { "strength": 3.0, "threshold": 0.05, "invert": 0.0 } },
    "lfo_strength": { "type": "LFO",             "params": { "frequency": 0.12, "amplitude": 4.0, "offset": 3.0 } },
    "vout":         { "type": "video_out" },
    "aout":         { "type": "audio_out" }
  },
  "connections": [
    { "from": "vid/texture",         "to": "edge/input" },
    { "from": "lfo_strength/value",  "to": "edge/strength" },
    { "from": "edge/texture",        "to": "vout/input" },
    { "from": "vid/time",            "to": "audio/video_time" },
    { "from": "audio/left",          "to": "aout/left" },
    { "from": "audio/right",         "to": "aout/right" }
  ]
}
