{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "paperjs_division_raster",
    "title": "Division Raster",
    "description": "Faithful port of Paper.js DivisionRaster — rectangular grid of average-colored cells with visible gaps, animated cell size.",
    "tags": ["demo", "paperjs", "raster", "mosaic"],
    "difficulty": "beginner",
    "domains": ["gpu", "control"],
    "requires_packages": [],
    "featured_rank": 15
  },
  "nodes": {
    "source": {
      "type": "TextureLoader",
      "params": {
        "file": ""
      }
    },
    "raster": {
      "type": "RasterGrid",
      "params": {
        "cell_size": 32.0,
        "gap": 2.0
      }
    },
    "lfo_size": {
      "type": "LFO",
      "params": {
        "frequency": 0.05,
        "amplitude": 40.0,
        "offset": 48.0,
        "waveform": 0
      }
    },
    "vout": {
      "type": "video_out",
      "params": {}
    }
  },
  "connections": [
    {"from": "source/texture",   "to": "raster/source"},
    {"from": "lfo_size/value",   "to": "raster/cell_size"},
    {"from": "raster/texture",   "to": "vout/input"}
  ]
}
