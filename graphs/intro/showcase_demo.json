{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "showcase_demo",
        "title": "Welcome to Vivid",
        "description": "Three drums, three visuals. Each drum triggers its own shape — you can see and hear the beat as one unified experience.",
        "tags": [
            "intro",
            "showcase",
            "audio-reactive",
            "drums"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio",
            "gpu",
            "control"
        ],
        "featured_rank": -1
    },
    "nodes": {
        "aout": {
            "type": "audio_out",
            "layout": {
                "x": 800.0,
                "y": 450.0
            }
        },
        "bloom": {
            "type": "Bloom",
            "params": {
                "threshold": 0.08,
                "intensity": 2.0
            },
            "layout": {
                "x": 1000.0,
                "y": 0.0
            }
        },
        "clock": {
            "type": "ClockAu",
            "params": {
                "bpm": 115.0
            },
            "layout": {
                "x": -400.0,
                "y": 400.0
            }
        },
        "comp1": {
            "type": "Composite",
            "params": {
                "opacity": 1.0,
                "blend_mode": 0.0
            },
            "layout": {
                "x": 550.0,
                "y": -75.0
            }
        },
        "comp2": {
            "type": "Composite",
            "params": {
                "opacity": 1.0,
                "blend_mode": 0.0
            },
            "layout": {
                "x": 700.0,
                "y": 0.0
            }
        },
        "fb": {
            "type": "Feedback",
            "params": {
                "rotate": 1.5,
                "mix": 0.75,
                "zoom": 1.01,
                "decay": 0.92
            },
            "layout": {
                "x": 850.0,
                "y": 0.0
            }
        },
        "hat": {
            "type": "DrumHiHat",
            "layout": {
                "x": 300.0,
                "y": 450.0
            }
        },
        "hat_shape": {
            "type": "Shape",
            "params": {
                "softness": 0.04,
                "sides": 6.0,
                "b": 1.0,
                "radius": 0.01,
                "r": 0.2,
                "g": 0.5
            },
            "layout": {
                "x": 300.0,
                "y": 150.0
            }
        },
        "kick": {
            "type": "DrumKick",
            "layout": {
                "x": 300.0,
                "y": 300.0
            }
        },
        "kick_shape": {
            "type": "Shape",
            "params": {
                "softness": 0.08,
                "sides": 64.0,
                "b": 0.1,
                "radius": 0.01,
                "r": 1.0,
                "g": 0.3
            },
            "layout": {
                "x": 300.0,
                "y": -150.0
            }
        },
        "kit": {
            "type": "DrumKitAu",
            "layout": {
                "x": 100.0,
                "y": 400.0
            }
        },
        "master": {
            "type": "Gain",
            "params": {
                "gain": 0.5
            },
            "layout": {
                "x": 550.0,
                "y": 450.0
            }
        },
        "seq": {
            "type": "DrumSequencerAu",
            "params": {
                "kick_8": 1.0,
                "snare_12": 1.0,
                "kick_4": 1.0,
                "kick_0": 1.0,
                "hat_8": 1.0,
                "hat_2": 1.0,
                "hat_6": 1.0,
                "kick_12": 1.0,
                "hat_4": 1.0,
                "hat_14": 1.0,
                "snare_4": 1.0,
                "hat_12": 1.0,
                "hat_10": 1.0,
                "hat_0": 1.0
            },
            "layout": {
                "x": -150.0,
                "y": 400.0
            }
        },
        "snare": {
            "type": "DrumSnare",
            "layout": {
                "x": 300.0,
                "y": 600.0
            }
        },
        "snare_shape": {
            "type": "Shape",
            "params": {
                "star": 0.3,
                "softness": 0.06,
                "sides": 4.0,
                "b": 1.0,
                "radius": 0.01,
                "r": 1.0,
                "g": 1.0
            },
            "layout": {
                "x": 300.0,
                "y": 0.0
            }
        },
        "vout": {
            "type": "video_out",
            "layout": {
                "x": 1150.0,
                "y": 0.0
            }
        },
        "xf_hat": {
            "type": "Transform",
            "params": {
                "translate_y": -0.2,
                "translate_x": 0.0
            },
            "layout": {
                "x": 450.0,
                "y": 150.0
            }
        },
        "xf_kick": {
            "type": "Transform",
            "params": {
                "translate_y": 0.15,
                "translate_x": -0.25
            },
            "layout": {
                "x": 450.0,
                "y": -150.0
            }
        },
        "xf_snare": {
            "type": "Transform",
            "params": {
                "translate_y": 0.0,
                "translate_x": 0.25
            },
            "layout": {
                "x": 450.0,
                "y": 0.0
            }
        }
    },
    "connections": [
        {
            "from": "clock/bar_phase",
            "to": "seq/beat_phase"
        },
        {
            "from": "seq/midi_out",
            "to": "kit/midi_in"
        },
        {
            "from": "kit/slot_0",
            "to": "kick/midi_in"
        },
        {
            "from": "kit/slot_1",
            "to": "snare/midi_in"
        },
        {
            "from": "kit/slot_2",
            "to": "hat/midi_in"
        },
        {
            "from": "kick/output",
            "to": "master/input"
        },
        {
            "from": "snare/output",
            "to": "master/input"
        },
        {
            "from": "hat/output",
            "to": "master/input"
        },
        {
            "from": "master/output",
            "to": "aout/input"
        },
        {
            "from": "kick/peak",
            "to": "kick_shape/radius",
            "from_min": 0.0,
            "from_max": 0.8,
            "to_min": 0.01,
            "to_max": 0.35,
            "bridge": "peak"
        },
        {
            "from": "snare/peak",
            "to": "snare_shape/radius",
            "from_min": 0.0,
            "from_max": 0.6,
            "to_min": 0.01,
            "to_max": 0.2,
            "bridge": "peak"
        },
        {
            "from": "hat/peak",
            "to": "hat_shape/radius",
            "from_min": 0.0,
            "from_max": 0.4,
            "to_min": 0.01,
            "to_max": 0.1,
            "bridge": "peak"
        },
        {
            "from": "kick_shape/texture",
            "to": "xf_kick/input"
        },
        {
            "from": "snare_shape/texture",
            "to": "xf_snare/input"
        },
        {
            "from": "hat_shape/texture",
            "to": "xf_hat/input"
        },
        {
            "from": "xf_kick/texture",
            "to": "comp1/a"
        },
        {
            "from": "xf_snare/texture",
            "to": "comp1/b"
        },
        {
            "from": "comp1/texture",
            "to": "comp2/a"
        },
        {
            "from": "xf_hat/texture",
            "to": "comp2/b"
        },
        {
            "from": "comp2/texture",
            "to": "fb/input"
        },
        {
            "from": "fb/texture",
            "to": "bloom/input"
        },
        {
            "from": "bloom/texture",
            "to": "vout/input"
        }
    ],
    "metronome": {
        "bpm": 115.0,
        "beats_per_bar": 4
    },
    "viewport": {
        "pan_x": 0.0,
        "pan_y": 0.0,
        "zoom": 0.7
    },
    "sticky_notes": [
        {
            "id": "welcome",
            "text": "**Welcome to Vivid!** Three drums, three shapes. Each drum directly triggers its own visual element — nothing is pre-animated. The music IS the animation.",
            "x": -400.0,
            "y": -200.0,
            "width": 350.0,
            "height": 100.0,
            "color": 0
        },
        {
            "id": "mapping",
            "text": "**Kick** → big orange circle\n**Snare** → white diamond\n**Hi-hat** → small blue hexagon\n\nEach drum’s peak level drives the shape’s radius through an audio→visual bridge wire.",
            "x": -400.0,
            "y": -70.0,
            "width": 300.0,
            "height": 130.0,
            "color": 1
        },
        {
            "id": "try_this",
            "text": "**Try this:** Click the DrumSequencer and toggle steps on/off. Watch how the visuals change instantly. Or change the BPM on the Clock node.",
            "x": -400.0,
            "y": 90.0,
            "width": 300.0,
            "height": 80.0,
            "color": 2
        }
    ]
}
