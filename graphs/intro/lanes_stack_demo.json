    "sticky_notes": [
        {
            "id": "note_intro",
            "text": "**Lanes: Stack** Stack combines independent signals into a single lane array. Each element in the output comes from a different source, giving every lane its own value.",
            "x": -270.0,
            "y": 50.0,
            "width": 300.0,
            "height": 120.0,
            "color": 0
        },
        {
            "id": "note_lfos",
            "text": "**Four LFOs** each produce a different X position. Different frequencies and offsets mean each ball wanders independently.",
            "x": -270.0,
            "y": 200.0,
            "width": 260.0,
            "height": 100.0,
            "color": 1
        },
        {
            "id": "note_stack",
            "text": "**Stack (concat)** merges 4 scalar inputs into a 4-lane array: [a, b, c, d]. This creates a lane set where element 0 is LFO A, element 1 is LFO B, etc.",
            "x": 30.0,
            "y": 200.0,
            "width": 280.0,
            "height": 120.0,
            "color": 1
        },
        {
            "id": "note_scalar",
            "text": "**Y and R are scalar** They auto-broadcast into the lane set established by Stack. All 4 balls share the same Y position and radius.",
            "x": 30.0,
            "y": 350.0,
            "width": 280.0,
            "height": 100.0,
            "color": 2
        },
        {
            "id": "note_result",
            "text": "**Each ball moves independently on X** because Stack gave each lane a unique signal. Compare with the Repeat demo where all balls overlap!",
            "x": 361.58594,
            "y": 270.69922,
            "width": 280.0,
            "height": 100.0,
            "color": 3
        }
    ]
