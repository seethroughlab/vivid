{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "demo",
    "title": "Getting Started",
    "description": "The simplest visual patch: a Clock drives an LFO that animates a noise texture. A good place to start exploring.",
    "tags": [
      "demo"
    ],
    "difficulty": "beginner",
    "domains": [
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 4
  },
  "nodes": {
    "clock1": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "lfo1": {
      "type": "LFO",
      "params": {
        "amplitude": 2.0,
        "offset": 4.0
      }
    },
    "noise1": {
      "type": "NoiseTexture",
      "params": {
        "speed": 1.0
      }
    },
    "vout": {
      "type": "video_out",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "clock1/beat_phase",
      "to": "lfo1/phase"
    },
    {
      "from": "lfo1/value",
      "to": "noise1/scale"
    },
    {
      "from": "noise1/texture",
      "to": "vout/input"
    }
  ],
  "sticky_notes": [
    {
      "id": "note_1",
      "text": "**Clock \u2192 LFO \u2192 Visual** pipeline\nThe Clock's beat_phase drives the LFO,\nwhich modulates the noise texture scale",
      "x": -100.0,
      "y": -80.0,
      "width": 280.0,
      "height": 80.0,
      "color": 0
    },
    {
      "id": "note_2",
      "text": "LFO offset=4 keeps scale positive;\namplitude=2 sweeps scale from 2\u20136",
      "x": 200.0,
      "y": -80.0,
      "width": 250.0,
      "height": 60.0,
      "color": 2
    }
  ]
}
