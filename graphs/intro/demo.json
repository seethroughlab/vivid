{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "demo",
    "title": "Demo",
    "description": "Demo demo graph.",
    "tags": [
      "demo"
    ],
    "difficulty": "beginner",
    "domains": [
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 4
  },
  "nodes": {
    "clock1": {
      "type": "Clock",
      "params": {
        "bpm": 120.0
      }
    },
    "lfo1": {
      "type": "LFO",
      "params": {
        "amplitude": 2.0,
        "offset": 4.0
      }
    },
    "noise1": {
      "type": "NoiseTexture",
      "params": {
        "speed": 1.0
      }
    },
    "vout": {
      "type": "video_out",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "clock1/beat_phase",
      "to": "lfo1/phase"
    },
    {
      "from": "lfo1/value",
      "to": "noise1/scale"
    },
    {
      "from": "noise1/texture",
      "to": "vout/input"
    }
  ]
}
