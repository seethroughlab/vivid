{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "av_metronome_demo",
        "title": "Shared Metronome AV Sync",
        "description": "The graph metronome keeps separate audio and visual LFOs locked without extra clock wires.",
        "tags": [
            "intro",
            "audio-visual",
            "metronome",
            "transport",
            "sync"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio",
            "gpu",
            "control"
        ],
        "requires_packages": [],
        "featured_rank": 11,
        "estimated_minutes": 1,
        "content_kind": "example",
        "category": "starter",
        "family": "Cross-domain starters",
        "role": "starter",
        "playability": "self_playing"
    },
    "metronome": {
        "enabled": true,
        "bpm": 118.0,
        "beats_per_bar": 4
    },
    "nodes": {
        "lfo_vis": {
            "type": "LfoFr",
            "params": {
                "amplitude": 2.8,
                "offset": 4.5,
                "waveform": 0,
                "rate_mode": 2,
                "sync_division": 3
            },
            "layout": {
                "x": 0.0,
                "y": 0.0
            }
        },
        "lfo_aud": {
            "type": "LfoFr",
            "params": {
                "amplitude": 120.0,
                "offset": 320.0,
                "waveform": 3,
                "rate_mode": 2,
                "sync_division": 4
            },
            "layout": {
                "x": 240.0,
                "y": 0.0
            }
        },
        "noise1": {
            "type": "NoiseTexture",
            "params": {
                "speed": 1.0
            },
            "layout": {
                "x": 480.0,
                "y": 0.0
            }
        },
        "osc1": {
            "type": "Oscillator",
            "params": {
                "frequency": 330.0,
                "amplitude": 0.45
            },
            "layout": {
                "x": 720.0,
                "y": 0.0
            }
        },
        "gain1": {
            "type": "Gain",
            "params": {
                "gain": 0.35
            },
            "layout": {
                "x": 960.0,
                "y": 0.0
            }
        },
        "out1": {
            "type": "audio_out",
            "params": {},
            "layout": {
                "x": 0.0,
                "y": 170.0
            }
        },
        "vout": {
            "type": "video_out",
            "params": {},
            "layout": {
                "x": 240.0,
                "y": 170.0
            }
        }
    },
    "connections": [
        {
            "from": "lfo_vis/value",
            "to": "noise1/scale"
        },
        {
            "from": "lfo_aud/value",
            "to": "osc1/frequency",
            "bridge": "hold"
        },
        {
            "from": "osc1/output",
            "to": "gain1/input"
        },
        {
            "from": "gain1/output",
            "to": "out1/input"
        },
        {
            "from": "noise1/texture",
            "to": "vout/input"
        }
    ],
    "sticky_notes": [
        {
            "id": "avm_note_1",
            "text": "**No Clock node required** Both LFOs read the graph metronome directly with different note divisions.",
            "x": -120.0,
            "y": -90.0,
            "width": 300.0,
            "height": 80.0,
            "color": 0
        },
        {
            "id": "avm_note_2",
            "text": "**Visual path**: eighth-note LFO modulates noise scale",
            "x": 220.0,
            "y": -90.0,
            "width": 230.0,
            "height": 60.0,
            "color": 3
        },
        {
            "id": "avm_note_3",
            "text": "**Audio path**: sixteenth-note LFO sweeps oscillator pitch",
            "x": 220.0,
            "y": 120.0,
            "width": 235.0,
            "height": 60.0,
            "color": 1
        }
    ]
}
