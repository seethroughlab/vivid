{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "audio_demo",
    "title": "Hello Audio",
    "description": "The simplest audio patch: a single 440 Hz oscillator through a gain control into the audio output.",
    "tags": [
      "demo"
    ],
    "difficulty": "beginner",
    "domains": [
      "audio",
      "control"
    ],
    "requires_packages": [],
    "featured_rank": 2
  },
  "nodes": {
    "osc1": {
      "type": "Oscillator",
      "params": {
        "frequency": 440.0,
        "amplitude": 0.5
      }
    },
    "gain1": {
      "type": "Gain",
      "params": {
        "gain": 0.8
      }
    },
    "out1": {
      "type": "audio_out",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "osc1/output",
      "to": "gain1/input"
    },
    {
      "from": "gain1/output",
      "to": "out1/input"
    }
  ],
  "sticky_notes": [
