{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "av_demo",
        "title": "Audio-Visual Sync",
        "description": "One shared LFO drives both a visual noise texture and an audio pitch sweep, showing how a single control signal can reach both domains.",
        "tags": [
            "audio-visual",
            "intro",
            "sync",
            "demo"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio",
            "gpu",
            "control"
        ],
        "featured_rank": 0
    },
    "nodes": {
        "clock1": {
            "type": "ClockFr",
            "params": {
                "bpm": 120.0
            },
            "layout": {
                "x": -200.0,
                "y": 300.0
            }
        },
        "gain1": {
            "type": "Gain",
            "params": {
                "gain": 0.3
            },
            "layout": {
                "x": 600.0,
                "y": 450.0
            }
        },
        "lfo1": {
            "type": "LfoFr",
            "params": {
                "polarity": 1.0,
                "offset": 5.0,
                "amplitude": 3.0
            },
            "layout": {
                "x": 50.0,
                "y": 300.0
            }
        },
        "noise1": {
            "type": "NoiseTexture",
            "params": {
                "speed": 1.0
            },
            "layout": {
                "x": 350.0,
                "y": 150.0
            }
        },
        "osc1": {
            "type": "Oscillator",
            "params": {
                "frequency": 330.0,
                "amplitude": 0.5
            },
            "layout": {
                "x": 350.0,
                "y": 450.0
            }
        },
        "out1": {
            "type": "audio_out",
            "layout": {
                "x": 850.0,
                "y": 450.0
            }
        },
        "vout": {
            "type": "video_out",
            "layout": {
                "x": 600.0,
                "y": 150.0
            }
        }
    },
    "connections": [
        {
            "from": "clock1/beat_phase",
            "to": "lfo1/beat_phase"
        },
        {
            "from": "lfo1/value",
            "to": "noise1/scale"
        },
        {
            "from": "lfo1/value",
            "to": "osc1/frequency",
            "from_min": 2.0,
            "from_max": 8.0,
            "to_min": 200.0,
            "to_max": 500.0,
            "bridge": "hold"
        },
        {
            "from": "osc1/output",
            "to": "gain1/input"
        },
        {
            "from": "gain1/output",
            "to": "out1/input"
        },
        {
            "from": "noise1/texture",
            "to": "vout/input"
        }
    ],
    "viewport": {
        "pan_x": 0.0,
        "pan_y": 0.0,
        "zoom": 1.0
    },
    "sticky_notes": [
        {
            "id": "note_shared",
            "text": "**One LFO, two domains.** The same LFO drives both the noise scale and the oscillator pitch. When the noise zooms in, the pitch rises — they move together because they share one source.",
            "x": -160.42969,
            "y": 119.640625,
            "width": 300.0,
            "height": 120.0,
            "color": 0
        },
        {
            "id": "note_visual",
            "text": "**Visual path**: LFO → noise scale (2–8). The raw LFO value controls the zoom level.",
            "x": 350.0,
            "y": 50.0,
            "width": 240.0,
            "height": 60.0,
            "color": 3
        },
        {
            "id": "note_audio",
            "text": "**Audio path**: LFO → oscillator frequency (200–500 Hz). The wire has a remap that scales the LFO’s 2–8 range into audible pitch.",
            "x": 393.39453,
            "y": 677.8008,
            "width": 280.0,
            "height": 80.0,
            "color": 1
        }
    ]
}
