{
  "nodes": {
    "vid":        { "type": "MovieFileIn",      "params": { "file": "media/camera.mp4", "play_mode": 0, "speed": 1.0 } },
    "audio":      { "type": "MovieFileAudioIn", "params": { "file": "media/camera.mp4" } },

    "hsv":        { "type": "HSV",              "params": { "hue_shift": 0.0, "saturation": 0.15, "value": 0.05 } },
    "levels":     { "type": "Levels",           "params": { "brightness": -0.02, "contrast": 1.4, "gamma": 0.9 } },
    "mirror":     { "type": "Mirror",           "params": { "mode": 3, "segments": 8.0, "angle": 0.0, "center_x": 0.5, "center_y": 0.5 } },
    "transform":  { "type": "Transform",        "params": { "scale_x": 1.0, "scale_y": 1.0, "rotation": 0.0, "translate_x": 0.0, "translate_y": 0.0, "pivot_x": 0.5, "pivot_y": 0.5 } },
    "edge":       { "type": "Edge",             "params": { "strength": 2.5, "threshold": 0.1, "invert": 0.0 } },
    "chroma":     { "type": "ChromaticAberration", "params": { "amount": 0.008, "angle": 45.0, "radial": 1.0 } },
    "scanlines":  { "type": "Scanlines",        "params": { "spacing": 3.0, "thickness": 0.4, "intensity": 0.25, "vertical": 0.0 } },
    "pixelate":   { "type": "Pixelate",         "params": { "size_x": 3.0, "size_y": 3.0 } },
    "posterize":  { "type": "Posterize",        "params": { "levels": 12.0 } },
    "crt":        { "type": "CRTEffect",        "params": { "curvature": 0.2, "vignette": 0.4, "scanline_intensity": 0.3, "bloom": 0.15, "chromatic": 0.003 } },

    "gradient":   { "type": "Gradient",         "params": { "mode": 1, "angle": 0.0, "center_x": 0.5, "center_y": 0.5, "scale": 0.8, "offset": 0.0 } },
    "noise":      { "type": "Noise",            "params": { "scale": 4.0, "speed": 0.3, "octaves": 3 } },
    "displace":   { "type": "Displace",         "params": { "amount": 0.03 } },

    "lfo_hue":    { "type": "LFO",              "params": { "frequency": 0.05, "amplitude": 180.0, "offset": 0.0, "waveform": 1 } },
    "lfo_rot":    { "type": "LFO",              "params": { "frequency": 0.02, "amplitude": 15.0, "offset": 0.0, "waveform": 1 } },
    "lfo_chroma": { "type": "LFO",              "params": { "frequency": 0.15, "amplitude": 0.01, "offset": 0.005 } },
    "lfo_pixel":  { "type": "LFO",              "params": { "frequency": 0.08, "amplitude": 4.0, "offset": 4.0 } },

    "vout":       { "type": "video_out" },
    "aout":       { "type": "audio_out" }
  },
  "connections": [
    { "from": "vid/texture",        "to": "hsv/input" },
    { "from": "hsv/texture",        "to": "levels/input" },
    { "from": "levels/texture",     "to": "mirror/input" },
    { "from": "mirror/texture",     "to": "displace/source" },
    { "from": "noise/texture",      "to": "displace/map" },
    { "from": "displace/texture",   "to": "transform/input" },
    { "from": "transform/texture",  "to": "posterize/input" },
    { "from": "posterize/texture",  "to": "pixelate/input" },
    { "from": "pixelate/texture",   "to": "chroma/input" },
    { "from": "chroma/texture",     "to": "scanlines/input" },
    { "from": "scanlines/texture",  "to": "crt/input" },
    { "from": "crt/texture",        "to": "vout/input" },

    { "from": "lfo_hue/value",      "to": "hsv/hue_shift" },
    { "from": "lfo_rot/value",      "to": "transform/rotation" },
    { "from": "lfo_chroma/value",   "to": "chroma/amount" },
    { "from": "lfo_pixel/value",    "to": "pixelate/size_x" },
    { "from": "lfo_pixel/value",    "to": "pixelate/size_y" },

    { "from": "vid/time",           "to": "audio/video_time" },
    { "from": "audio/left",         "to": "aout/left" },
    { "from": "audio/right",        "to": "aout/right" }
  ]
}
