{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "scanlines_demo",
    "title": "Scanlines",
    "description": "Scanlines demo graph.",
    "tags": [
      "scanlines",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 30
  },
  "nodes": {
    "vid": {
      "type": "MovieLoaded",
      "params": {
        "file": "../../assets/camera.mp4",
        "play_mode": 0,
        "speed": 1.0
      }
    },
    "audio": {
      "type": "MovieAudioOut",
      "params": {
        "file": "../../assets/camera.mp4"
      }
    },
    "scanlines": {
      "type": "Scanlines",
      "params": {
        "spacing": 4.0,
        "thickness": 0.5,
        "intensity": 0.6,
        "vertical": 0.0
      }
    },
    "levels": {
      "type": "Levels",
      "params": {
        "brightness": -0.05,
        "contrast": 1.3,
        "gamma": 0.9
      }
    },
    "vout": {
      "type": "video_out"
    },
    "aout": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "vid/texture",
      "to": "levels/input"
    },
    {
      "from": "levels/texture",
      "to": "scanlines/input"
    },
    {
      "from": "scanlines/texture",
      "to": "vout/input"
    },
    {"from": "vid/media_clock", "to": "audio/media_stream"},
    {
      "from": "audio/left",
      "to": "aout/left"
    },
    {
      "from": "audio/right",
      "to": "aout/right"
    }
  ]
}
