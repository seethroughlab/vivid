{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "scanlines_demo",
    "title": "Scanlines",
    "description": "CRT-style horizontal scanlines overlaid on video after levels adjustment.",
    "tags": [
      "scanlines",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 30
  },
  "nodes": {
    "vid": {
      "type": "MovieFileIn",
      "params": {
        "file": "../../assets/camera.mp4",
        "play_mode": 0,
        "speed": 1.0
      }
    },
    "audio": {
      "type": "MovieFileAudio",
      "params": {
        "file": "../../assets/camera.mp4"
      }
    },
    "scanlines": {
      "type": "Scanlines",
      "params": {
        "spacing": 4.0,
        "thickness": 0.5,
        "intensity": 0.6,
        "vertical": 0.0
      }
    },
    "levels": {
      "type": "Levels",
      "params": {
        "brightness": -0.05,
        "contrast": 1.3,
        "gamma": 0.9
      }
    },
    "vout": {
      "type": "video_out"
    },
    "aout": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "vid/texture",
      "to": "levels/input",
      "bridge": "last_sample"
    },
    {
      "from": "levels/texture",
      "to": "scanlines/input"
    },
    {
      "from": "scanlines/texture",
      "to": "vout/input"
    },
    {
      "from": "audio/time",
      "to": "vid/audio_time",
      "bridge": "last_sample"
    },
    {
      "from": "audio/output",
      "to": "aout/input"
    }
  ]
}