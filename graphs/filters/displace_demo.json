{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "displace_demo",
    "title": "Displacement Map",
    "description": "Warps a hexagon shape using a noise-based displacement map with LFO-animated intensity.",
    "tags": [
      "displace",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 23
  },
  "nodes": {
    "source": {
      "type": "Shape",
      "params": {
        "sides": 6,
        "radius": 0.35,
        "softness": 0.01,
        "r": 0.2,
        "g": 0.6,
        "b": 1.0
      }
    },
    "map": {
      "type": "NoiseTexture",
      "params": {
        "scale": 2.0,
        "speed": 0.8,
        "octaves": 3
      }
    },
    "lfo1": {
      "type": "LFO",
      "params": {
        "frequency": 0.3,
        "amplitude": 0.4,
        "offset": 0.5
      }
    },
    "displace": {
      "type": "Displace",
      "params": {}
    },
    "vout": {
      "type": "video_out",
      "params": {}
    }
  },
  "connections": [
    {
      "from": "source/texture",
      "to": "displace/source"
    },
    {
      "from": "map/texture",
      "to": "displace/map"
    },
    {
      "from": "lfo1/value",
      "to": "displace/amount"
    },
    {
      "from": "displace/texture",
      "to": "vout/input"
    }
  ],
  "sticky_notes": [
    {
      "id": "note_1",
      "text": "**Displacement Mapping** The **source** (hexagon) is warped by the **map** (noise texture)",
      "x": -100.0,
      "y": -80.0,
      "width": 260.0,
      "height": 80.0,
      "color": 0
    },
    {
      "id": "note_2",
      "text": "Bright pixels in the map push source pixels further; LFO animates the displacement amount",
      "x": -100.0,
      "y": 150.0,
      "width": 250.0,
      "height": 80.0,
      "color": 4
    }
  ]
}
