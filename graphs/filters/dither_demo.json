{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "dither_demo",
        "title": "Dithering",
        "description": "A smooth gradient is reduced into animated dithered color bands.",
        "tags": [
            "dither",
            "color-reduction",
            "retro",
            "demo"
        ],
        "difficulty": "intermediate",
        "domains": [
            "gpu"
        ],
        "requires_packages": [],
        "featured_rank": 40,
        "estimated_minutes": 3,
        "content_kind": "example",
        "category": "filter",
        "family": "Shader filters",
        "role": "creative",
        "playability": "self_playing"
    },
    "nodes": {
        "grad": {
            "type": "Gradient",
            "params": {
                "mode": 1,
                "center_x": 0.5,
                "center_y": 0.5,
                "scale": 1.2
            },
            "resolution": [
                800,
                600
            ],
            "layout": {
                "x": 0.0,
                "y": 0.0
            }
        },
        "dither": {
            "type": "Dither",
            "params": {
                "pattern": 2,
                "levels": 4.0,
                "strength": 1.0
            },
            "layout": {
                "x": 240.0,
                "y": 0.0
            }
        },
        "lfo_levels": {
            "type": "LfoFr",
            "params": {
                "frequency": 0.1,
                "amplitude": 6.0,
                "offset": 8.0
            },
            "layout": {
                "x": 480.0,
                "y": 0.0
            }
        },
        "vout": {
            "type": "video_out",
            "layout": {
                "x": 720.0,
                "y": 0.0
            }
        }
    },
    "connections": [
        {
            "from": "grad/texture",
            "to": "dither/input"
        },
        {
            "from": "lfo_levels/value",
            "to": "dither/levels"
        },
        {
            "from": "dither/texture",
            "to": "vout/input"
        }
    ]
}
