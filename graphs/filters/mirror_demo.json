{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "mirror_demo",
        "title": "Kaleidoscope Mirror",
        "description": "A video source becomes a rotating kaleidoscope with mirrored segments.",
        "tags": [
            "mirror",
            "symmetry",
            "kaleidoscope",
            "demo"
        ],
        "difficulty": "intermediate",
        "domains": [
            "gpu"
        ],
        "requires_packages": [],
        "featured_rank": 42,
        "estimated_minutes": 3,
        "content_kind": "example",
        "category": "filter",
        "family": "Shader filters",
        "role": "creative",
        "playability": "self_playing"
    },
    "nodes": {
        "vid": {
            "type": "MovieFile",
            "params": {
                "file": "../../assets/lake.mp4",
                "play_mode": 0,
                "speed": 1.0
            },
            "layout": {
                "x": 0.0,
                "y": 0.0
            }
        },
        "mirror": {
            "type": "Mirror",
            "params": {
                "mode": 3,
                "segments": 8.0,
                "angle": 0.0
            },
            "layout": {
                "x": 480.0,
                "y": 0.0
            }
        },
        "lfo_angle": {
            "type": "LfoFr",
            "params": {
                "frequency": 0.05,
                "amplitude": 180.0,
                "offset": 0.0
            },
            "layout": {
                "x": 720.0,
                "y": 0.0
            }
        },
        "vout": {
            "type": "video_out",
            "layout": {
                "x": 960.0,
                "y": 0.0
            }
        },
        "aout": {
            "type": "audio_out",
            "layout": {
                "x": 0.0,
                "y": 170.0
            }
        }
    },
    "connections": [
        {
            "from": "vid/texture",
            "to": "mirror/input"
        },
        {
            "from": "lfo_angle/value",
            "to": "mirror/angle"
        },
        {
            "from": "mirror/texture",
            "to": "vout/input"
        },
        {
            "from": "vid/audio",
            "to": "aout/input"
        }
    ]
}
