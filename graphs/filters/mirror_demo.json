{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "mirror_demo",
    "title": "Mirror",
    "description": "Mirror demo graph.",
    "tags": [
      "mirror",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 28
  },
  "nodes": {
    "vid": {
      "type": "MovieLoaded",
      "params": {
        "file": "../../assets/lake.mp4",
        "play_mode": 0,
        "speed": 1.0
      }
    },
    "audio": {
      "type": "MovieAudioOut",
      "params": {
        "file": "../../assets/lake.mp4"
      }
    },
    "mirror": {
      "type": "Mirror",
      "params": {
        "mode": 3,
        "segments": 8.0,
        "angle": 0.0
      }
    },
    "lfo_angle": {
      "type": "LFO",
      "params": {
        "frequency": 0.05,
        "amplitude": 180.0,
        "offset": 0.0
      }
    },
    "vout": {
      "type": "video_out"
    },
    "aout": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "vid/texture",
      "to": "mirror/input"
    },
    {
      "from": "lfo_angle/value",
      "to": "mirror/angle"
    },
    {
      "from": "mirror/texture",
      "to": "vout/input"
    },
    {"from": "vid/media_clock", "to": "audio/media_stream"},
    {
      "from": "audio/output",
      "to": "aout/input"
    }
  ]
}
