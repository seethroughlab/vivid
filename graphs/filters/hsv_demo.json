{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "hsv_demo",
    "title": "HSV Color Adjust",
    "description": "Hue, saturation, and brightness adjustments with an LFO continuously rotating the hue.",
    "tags": [
      "hsv",
      "demo"
    ],
    "difficulty": "intermediate",
    "domains": [
      "gpu"
    ],
    "requires_packages": [],
    "featured_rank": 27
  },
  "nodes": {
    "vid": {
      "type": "MovieLoaded",
      "params": {
        "file": "../../assets/camera.mp4",
        "play_mode": 0,
        "speed": 1.0
      }
    },
    "audio": {
      "type": "MovieAudioOut",
      "params": {
        "file": "../../assets/camera.mp4"
      }
    },
    "hsv": {
      "type": "HSV",
      "params": {
        "hue_shift": 0.0,
        "saturation": 0.2,
        "value": 0.0
      }
    },
    "lfo_hue": {
      "type": "LFO",
      "params": {
        "frequency": 0.1,
        "amplitude": 180.0,
        "offset": 180.0
      }
    },
    "vout": {
      "type": "video_out"
    },
    "aout": {
      "type": "audio_out"
    }
  },
  "connections": [
    {
      "from": "vid/texture",
      "to": "hsv/input"
    },
    {
      "from": "lfo_hue/value",
      "to": "hsv/hue_shift"
    },
    {
      "from": "hsv/texture",
      "to": "vout/input"
    },
    {
      "from": "vid/media_clock",
      "to": "audio/media_stream"
    },
    {
      "from": "audio/output",
      "to": "aout/input"
    }
  ]
}
