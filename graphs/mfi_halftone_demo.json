{
  "nodes": {
    "vid":      { "type": "MovieFileIn",      "params": { "file": "../media/camera.mp4", "play_mode": 0, "speed": 1.0 } },
    "audio":    { "type": "MovieFileAudioIn", "params": { "file": "../media/camera.mp4" } },
    "halftone": { "type": "Halftone",         "params": { "dot_size": 12.0, "angle": 0.4 } },
    "lfo1":     { "type": "LFO",              "params": { "frequency": 0.15, "amplitude": 20.0, "offset": 10.0 } },
    "vout":     { "type": "video_out" },
    "aout":     { "type": "audio_out" }
  },
  "connections": [
    { "from": "vid/texture",      "to": "halftone/input" },
    { "from": "lfo1/value",       "to": "halftone/dot_size" },
    { "from": "halftone/texture", "to": "vout/input" },
    { "from": "vid/time",         "to": "audio/video_time" },
    { "from": "audio/left",       "to": "aout/left" },
    { "from": "audio/right",      "to": "aout/right" }
  ]
}
