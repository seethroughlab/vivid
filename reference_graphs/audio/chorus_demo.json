{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "chorus_demo",
        "title": "Chorus Ensemble Effect",
        "description": "A saw oscillator through a 4-voice chorus with LFO-modulated rate for an evolving ensemble shimmer.",
        "tags": [
            "audio",
            "chorus",
            "modulation",
            "demo"
        ],
        "difficulty": "beginner",
        "domains": [
            "audio",
            "control"
        ],
        "requires_packages": [],
        "featured_rank": 30,
        "content_kind": "example",
        "category": "audio",
        "family": "Audio reference",
        "role": "reference",
        "playability": "self_playing"
    },
    "nodes": {
        "osc": {
            "type": "Oscillator",
            "params": {
                "frequency": 220.0,
                "amplitude": 0.7,
                "waveform": 1
            }
        },
        "lfo": {
            "type": "Lfo",
            "params": {
                "frequency": 0.15,
                "amplitude": 0.4,
                "waveform": 0
            }
        },
        "chorus": {
            "type": "Chorus",
            "params": {
                "rate": 0.8,
                "depth": 0.6,
                "voices": 4,
                "mix": 0.6
            }
        },
        "gain": {
            "type": "Gain",
            "params": {
                "gain": 0.7
            }
        },
        "out": {
            "type": "audio_out",
            "params": {}
        }
    },
    "connections": [
        {
            "from": "osc/output",
            "to": "chorus/input"
        },
        {
            "from": "lfo/value",
            "to": "chorus/rate_cv"
        },
        {
            "from": "chorus/output",
            "to": "gain/input"
        },
        {
            "from": "gain/output",
            "to": "out/input"
        }
    ]
}
