{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "midi_demo",
        "title": "MIDI Control",
        "description": "MIDI CC values modulate LFO frequency, which drives noise texture generation \u2014 a template for MIDI-controlled patches.",
        "tags": [
            "midi",
            "keyboard",
            "real-time",
            "demo"
        ],
        "difficulty": "intermediate",
        "domains": [
            "io",
            "audio",
            "control"
        ],
        "requires_packages": [],
        "featured_rank": 21,
        "content_kind": "example",
        "category": "io",
        "family": "I/O reference",
        "role": "reference",
        "playability": "self_playing"
    },
    "nodes": {
        "midi1": {
            "type": "MidiInput",
            "params": {
                "device": 0,
                "channel": 0,
                "cc_number": 1
            }
        },
        "lfo1": {
            "type": "Lfo",
            "params": {
                "amplitude": 2.0,
                "offset": 4.0
            }
        },
        "noise1": {
            "type": "NoiseTexture",
            "params": {
                "speed": 1.0
            }
        },
        "vout": {
            "type": "video_out",
            "params": {}
        }
    },
    "connections": [
        {
            "from": "midi1/cc_value",
            "to": "lfo1/frequency",
            "bridge": "hold"
        },
        {
            "from": "lfo1/value",
            "to": "noise1/scale",
            "bridge": "last_sample"
        },
        {
            "from": "noise1/texture",
            "to": "vout/input"
        }
    ]
}
