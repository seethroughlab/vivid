{
    "schema_version": 3,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "lut_apply_demo",
        "title": "LUT Apply",
        "description": "3D LUT color grading with animated intensity showing before/after.",
        "tags": [
            "demo",
            "color-science",
            "lut",
            "color-grading"
        ],
        "difficulty": "beginner",
        "domains": [
            "gpu",
            "control"
        ],
        "requires_packages": [],
        "featured_rank": 34,
        "content_kind": "example",
        "category": "filter",
        "family": "Shader filter reference",
        "role": "reference",
        "playability": "self_playing"
    },
    "nodes": {
        "vid": {
            "type": "MovieFile",
            "params": {
                "play_mode": 0.0,
                "speed": 1.0,
                "file": "../../assets/camera.mp4"
            }
        },
        "lut": {
            "type": "LUT Apply",
            "params": {
                "file": "../../assets/warm_tone.cube",
                "intensity": 1.0
            }
        },
        "lfo_intensity": {
            "type": "LfoFr",
            "params": {
                "frequency": 0.15,
                "amplitude": 0.5,
                "offset": 0.5,
                "waveform": 0
            }
        },
        "vout": {
            "type": "video_out"
        },
        "aout": {
            "type": "audio_out"
        }
    },
    "connections": [
        {
            "from": "vid/texture",
            "to": "lut/input"
        },
        {
            "from": "lfo_intensity/value",
            "to": "lut/intensity"
        },
        {
            "from": "lut/texture",
            "to": "vout/input"
        },
        {
            "from": "vid/audio",
            "to": "aout/input"
        }
    ]
}
