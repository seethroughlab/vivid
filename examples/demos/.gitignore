# Throwaway projects written by the demo .py scripts (save_project output) are ignored,
# but curated, committed bundled examples under projects/ are kept (add a !exception each).
projects/*
!projects/generative-fields/
!projects/geometry/
!projects/surge-lead/
!projects/bloom/
!projects/drift/
!projects/grid/
!projects/signal/
# ...but never the compiled operator dylib — a demo that carries a project-local operator (ADR-0054)
# rebuilds it from source on project open (project_io.cpp: install_package). Source (.cpp + manifest)
# IS committed; the .dylib is a build artifact.
projects/bloom/*.dylib
projects/geometry/*.dylib
projects/grid/*.dylib
projects/surge-lead/*.dylib
__pycache__/
