{
  "checks": [
    {
      "id": "movie_clean_runtime",
      "type": "state_check",
      "path": "nodes.vid.health.errored",
      "op": "==",
      "value": false,
      "severity": "critical",
      "message": "MovieFile must be healthy during AV-sync certification."
    },
    {
      "id": "movie_no_underruns",
      "type": "state_check",
      "path": "nodes.vid.outputs.underruns.scalar",
      "op": "==",
      "value": 0,
      "severity": "critical",
      "message": "MovieFile underruns must remain at zero in healthy synced playback."
    },
    {
      "id": "no_large_drift_warning",
      "type": "diagnostic_check",
      "op": "finding_absent",
      "finding_id": "movie_sustained_large_drift",
      "severity": "critical",
      "message": "Healthy AV-sync playback must not trigger sustained large drift warnings."
    },
    {
      "id": "no_nil_frame_stall",
      "type": "diagnostic_check",
      "op": "finding_absent",
      "finding_id": "movie_sustained_nil_frames",
      "severity": "critical",
      "message": "Healthy playback must not stall in the decoder path."
    },
    {
      "id": "no_seek_churn",
      "type": "diagnostic_check",
      "op": "finding_absent",
      "finding_id": "movie_seek_churn",
      "severity": "critical",
      "message": "Steady-state playback must not be issuing repeated AV correction seeks."
    },
    {
      "id": "video_drift_under_100ms",
      "type": "state_check",
      "path": "nodes.vid.outputs.drift_ms.scalar",
      "op": "<=",
      "value": 100,
      "severity": "critical",
      "message": "Steady-state AV drift must settle below 100 ms."
    }
  ]
}
