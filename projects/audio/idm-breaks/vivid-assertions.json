    {"name": "no-clipping", "path": "audio.peakLevel", "op": "<", "value": 0.95, "message": "Audio should not clip"},
    {"name": "visual-ok", "path": "output.meanBrightness", "op": "between", "value": [0.01, 0.95], "message": "Visual output present"}
  ]
}
