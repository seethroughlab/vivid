# Generated by vivid export — do not edit
cmake_minimum_required(VERSION 3.20)
project(vivid_standalone LANGUAGES C CXX OBJC OBJCXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

set(VIVID_SRC "${VIVID_SRC}")
set(VIVID_BUILD "${VIVID_BUILD}")

# --- Dawn/WebGPU (reuse already-fetched from vivid build tree) ---
include(FetchContent)
FetchContent_Declare(
    webgpu
    GIT_REPOSITORY https://github.com/eliemichel/WebGPU-distribution
    GIT_TAG        main
    GIT_SHALLOW    TRUE
)
FetchContent_MakeAvailable(webgpu)

# --- GLFW (from vivid deps submodule) ---
set(GLFW_BUILD_DOCS     OFF CACHE BOOL "" FORCE)
set(GLFW_BUILD_TESTS    OFF CACHE BOOL "" FORCE)
set(GLFW_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(GLFW_INSTALL        OFF CACHE BOOL "" FORCE)
add_subdirectory(${VIVID_SRC}/deps/glfw ${CMAKE_BINARY_DIR}/_deps/glfw)

# --- glfw3webgpu bridge ---
add_subdirectory(${VIVID_SRC}/deps/glfw3webgpu ${CMAKE_BINARY_DIR}/_deps/glfw3webgpu)

# --- yyjson ---
add_library(yyjson STATIC ${VIVID_SRC}/deps/yyjson/yyjson.c)
target_include_directories(yyjson PUBLIC ${VIVID_SRC}/deps/yyjson)

# --- miniaudio ---
add_library(miniaudio INTERFACE)
target_include_directories(miniaudio INTERFACE ${VIVID_SRC}/deps/miniaudio)

# --- RtMidi (always needed for system_midi.cpp) ---
add_library(rtmidi STATIC ${VIVID_SRC}/deps/rtmidi/RtMidi.cpp)
target_include_directories(rtmidi PUBLIC ${VIVID_SRC}/deps/rtmidi)
target_compile_definitions(rtmidi PUBLIC __MACOSX_CORE__)
target_link_libraries(rtmidi PUBLIC
    "-framework CoreMIDI" "-framework CoreAudio" "-framework CoreFoundation")

# --- Operator API ---
add_library(vivid_operator_api INTERFACE)
target_include_directories(vivid_operator_api INTERFACE ${VIVID_SRC}/src)

# --- Operator OBJECT libraries (symbol-renamed) ---
${OPERATOR_OBJECT_LIBRARIES}

# --- Control server (optional) ---
set(STANDALONE_CONTROL_SERVER ${STANDALONE_CONTROL_SERVER})
set(CONTROL_SERVER_SOURCES "")
set(CONTROL_SERVER_LIBS "")
set(CONTROL_SERVER_DEFS "")
if(STANDALONE_CONTROL_SERVER)
    FetchContent_Declare(
        ixwebsocket
        GIT_REPOSITORY https://github.com/machinezone/IXWebSocket
        GIT_TAG        v11.4.5
        GIT_SHALLOW    TRUE
    )
    set(USE_TLS OFF CACHE BOOL "" FORCE)
    set(IXWEBSOCKET_INSTALL OFF CACHE BOOL "" FORCE)
    FetchContent_MakeAvailable(ixwebsocket)
    set(CONTROL_SERVER_SOURCES
        ${VIVID_SRC}/src/runtime/control_server.cpp
        ${VIVID_SRC}/src/runtime/capture_coordinator.cpp
        ${VIVID_SRC}/src/runtime/screenshot.cpp
        ${VIVID_SRC}/src/runtime/av_exporter.mm
        ${VIVID_SRC}/src/runtime/operator_creator.cpp
        ${VIVID_SRC}/src/runtime/hot_reload.cpp
    )
    set_source_files_properties(${VIVID_SRC}/src/runtime/av_exporter.mm
        PROPERTIES COMPILE_FLAGS "-fobjc-arc")
    set(CONTROL_SERVER_LIBS ixwebsocket stb_truetype
        "-framework AVFoundation" "-framework CoreMedia" "-framework VideoToolbox" "-framework Foundation")
    set(CONTROL_SERVER_DEFS VIVID_STANDALONE_CONTROL_SERVER)

    add_library(stb_truetype INTERFACE)
    target_include_directories(stb_truetype INTERFACE ${VIVID_SRC}/deps/stb)
endif()

# --- WGSL preset sources ---
set(WGSL_PRESET_SOURCES "${WGSL_PRESET_SOURCES}")
set(WGSL_DEFS "")
if(NOT "${WGSL_PRESET_SOURCES}" STREQUAL "")
    set(WGSL_DEFS VIVID_HAS_WGSL_PRESETS)
endif()

# --- Headless mode ---
set(STANDALONE_HEADLESS ${STANDALONE_HEADLESS})

# --- Standalone executable ---
add_executable(standalone
    ${CMAKE_CURRENT_SOURCE_DIR}/standalone_main.cpp
    ${CMAKE_CURRENT_SOURCE_DIR}/static_registry.cpp
    ${WGSL_PRESET_SOURCES}

    # Runtime sources (subset)
    ${VIVID_SRC}/src/runtime/gpu_context.cpp
    ${VIVID_SRC}/src/runtime/fullscreen_blit.cpp
    ${VIVID_SRC}/src/runtime/operator_loader.cpp
    ${VIVID_SRC}/src/runtime/operator_registry.cpp
    ${VIVID_SRC}/src/runtime/wgsl_header_parser.cpp
    ${VIVID_SRC}/src/runtime/graph.cpp
    ${VIVID_SRC}/src/runtime/scheduler.cpp
    ${VIVID_SRC}/src/runtime/audio_engine.cpp
    ${VIVID_SRC}/src/runtime/builtin_operators.cpp
    ${VIVID_SRC}/src/runtime/runtime_api.cpp
    ${VIVID_SRC}/src/runtime/system_midi.cpp
    ${VIVID_SRC}/src/runtime/platform.cpp
    ${VIVID_SRC}/src/runtime/macos_frame_timer.cpp

    ${CONTROL_SERVER_SOURCES}

    # Operator OBJECT libraries
    ${OPERATOR_OBJECT_TARGETS}
)

target_include_directories(standalone PRIVATE
    ${VIVID_SRC}/src
    ${VIVID_SRC}/operators
    ${CMAKE_CURRENT_SOURCE_DIR}
)

target_link_libraries(standalone PRIVATE
    vivid_operator_api
    webgpu
    glfw
    glfw3webgpu
    yyjson
    miniaudio
    ${CONTROL_SERVER_LIBS}
)

target_link_libraries(standalone PRIVATE rtmidi)

target_compile_definitions(standalone PRIVATE
    ${CONTROL_SERVER_DEFS}
    ${WGSL_DEFS}
)

# macOS frameworks
if(APPLE)
    target_link_libraries(standalone PRIVATE
        "-framework Cocoa"
        "-framework CoreVideo"
        "-framework IOKit"
        "-framework QuartzCore"
${OPERATOR_FRAMEWORKS}
    )
endif()

# Copy Dawn shared library next to the executable
target_copy_webgpu_binaries(standalone)
