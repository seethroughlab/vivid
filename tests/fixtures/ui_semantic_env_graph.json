{
  "schema_version": 1,
  "vivid_version": "0.1.0",
  "meta": {
    "id": "ui_semantic_env_graph",
    "title": "UI Semantic Env Graph",
    "description": "Visible envelope fixture for semantic GUI smoke assertions.",
    "tags": ["test", "ui", "env"],
    "difficulty": "beginner",
    "domains": ["control", "gpu"],
    "requires_packages": []
  },
  "nodes": {
    "clock1": {
      "type": "Clock",
      "params": {
        "bpm": 96.0,
        "beats_per_bar": 4
      },
      "layout": {
        "x": 120.0,
        "y": 150.0
      }
    },
    "env": {
      "type": "Envelope",
      "params": {
        "attack": 0.03,
        "decay": 0.24,
        "sustain": 0.65,
        "release": 0.28,
        "amplitude": 0.18,
        "offset": 0.16,
        "curve": 1
      },
      "layout": {
        "x": 360.0,
        "y": 150.0
      }
    },
    "shape1": {
      "type": "Shape2D",
      "params": {
        "sides": 5,
        "softness": 0.01,
        "scale_x": 0.28,
        "scale_y": 0.28,
        "r": 0.94,
        "g": 0.56,
        "b": 0.18
      },
      "layout": {
        "x": 620.0,
        "y": 150.0
      }
    },
    "render1": {
      "type": "Render2D",
      "layout": {
        "x": 760.0,
        "y": 150.0
      }
    },
    "vout": {
      "type": "video_out",
      "layout": {
        "x": 900.0,
        "y": 150.0
      }
    }
  },
  "connections": [
    {
      "from": "clock1/beat_phase",
      "to": "env/beat_phase"
    },
    {
      "from": "env/value",
      "to": "shape1/scale_x"
    },
    {
      "from": "shape1/drawable",
      "to": "render1/drawable"
    },
    {
      "from": "render1/texture",
      "to": "vout/input"
    }
  ]
}
