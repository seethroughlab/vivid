{
    "schema_version": 1,
    "vivid_version": "0.1.0",
    "meta": {
        "id": "convolution_reverb_percussion_fixture",
        "title": "Convolution Reverb Percussion Fixture",
        "description": "Listening fixture for the high-quality stereo ConvolutionReverb path using transient drum material.",
        "tags": [
            "audio",
            "reverb",
            "convolution",
            "listening-fixture"
        ],
        "difficulty": "intermediate",
        "domains": [
            "audio",
            "control"
        ],
        "requires_packages": []
    },
    "nodes": {
        "clock": {
            "type": "Clock",
            "params": {
                "bpm": 116.0
            }
        },
        "seq": {
            "type": "DrumSequencer",
            "params": {
                "steps": 16,
                "kick_0": 1.0,
                "kick_8": 1.0,
                "snare_4": 1.0,
                "snare_12": 1.0,
                "hat_0": 1.0,
                "hat_2": 1.0,
                "hat_4": 1.0,
                "hat_6": 1.0,
                "hat_8": 1.0,
                "hat_10": 1.0,
                "hat_12": 1.0,
                "hat_14": 1.0
            }
        },
        "kit": {
            "type": "DrumKit",
            "params": {}
        },
        "kick": {
            "type": "DrumKick",
            "params": {
                "volume": 0.35,
                "decay": 0.32
            }
        },
        "snare": {
            "type": "DrumSnare",
            "params": {
                "volume": 0.22,
                "snappy": 0.7
            }
        },
        "hat": {
            "type": "DrumHiHat",
            "params": {
                "volume": 0.14,
                "decay": 0.05
            }
        },
        "verb": {
            "type": "ConvolutionReverb",
            "params": {
                "ir_preset": 1,
                "mix": 0.28,
                "pre_delay_ms": 12.0,
                "width": 1.25,
                "tail_seconds": 2.0
            }
        },
        "out": {
            "type": "audio_out",
            "params": {}
        }
    },
    "connections": [
        {
            "from": "clock/bar_phase",
            "to": "seq/beat_phase"
        },
        {
            "from": "seq/midi_out",
            "to": "kit/midi_in"
        },
        {
            "from": "kit/slot_0",
            "to": "kick/midi_in"
        },
        {
            "from": "kit/slot_1",
            "to": "snare/midi_in"
        },
        {
            "from": "kit/slot_2",
            "to": "hat/midi_in"
        },
        {
            "from": "kick/output",
            "to": "verb/input"
        },
        {
            "from": "snare/output",
            "to": "verb/input"
        },
        {
            "from": "hat/output",
            "to": "verb/input"
        },
        {
            "from": "verb/output",
            "to": "out/input"
        }
    ]
}
